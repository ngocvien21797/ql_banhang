@model IEnumerable<QuanLyBanHang.Models.PurchaseInvoice>
@{
    ViewData["Title"] = "Phiếu nhập";
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-box-seam me-2"></i>Phiếu nhập</h3>
        <p>Quản lý phiếu nhập hàng</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-dark" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Tạo phiếu nhập</a>
    </div>
</div>

<form method="get" class="filters-bar">
    <div class="form-group">
        <label class="form-label">Tìm kiếm</label>
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo nhà cung cấp..." value="@Context.Request.Query["search"]" style="width:200px">
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-search"></i> Lọc</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i> Xóa lọc</a>
    </div>
</form>

<div class="card-modern">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã phiếu</th>
                    <th>Ngày</th>
                    <th>Nhà cung cấp</th>
                    <th class="text-center">Số SP</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-end" style="width:200px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@x.Id</td>
                        <td>@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(x.Supplier?.Name ?? "Không có NCC")</td>
                        <td class="text-center">
                            <span class="badge bg-info">@x.Items.Count</span>
                        </td>
                        <td class="text-end fw-semibold">@string.Format("{0:N0}", x.Total) đ</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.Id"><i class="bi bi-eye me-1"></i>Xem</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.Id"><i class="bi bi-trash me-1"></i>Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-end">
        <partial name="_Pagination" model="ViewBag.Pagination" />
    </div>
</div>
