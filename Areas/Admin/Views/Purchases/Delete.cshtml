@model QuanLyBanHang.Models.PurchaseInvoice
@{
    ViewData["Title"] = "Xóa phiếu nhập";
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-trash me-2"></i>Xóa phiếu nhập</h3>
        <p>Thao tác này không thể hoàn tác</p>
    </div>
</div>

<div class="form-card">
    <div class="card-body">
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Bạn chắc chắn muốn xóa phiếu nhập <strong>#@Model.Id</strong> ? (Hệ thống sẽ trừ lại kho theo các dòng chi tiết)</span>
        </div>
        <form method="post">
            <div class="card-footer px-0 d-flex gap-2">
                <button class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xóa</button>
                <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-x-lg me-1"></i>Hủy</a>
            </div>
        </form>
    </div>
</div>
