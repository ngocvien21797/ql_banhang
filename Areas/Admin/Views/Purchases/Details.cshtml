@model QuanLyBanHang.Models.PurchaseInvoice
@{
    ViewData["Title"] = "Chi tiết phiếu nhập";
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-eye me-2"></i>Chi tiết phiếu nhập #@Model.Id</h3>
        <p>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="detail-card">
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width:140px;">Ngày</td>
                            <td class="fw-semibold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Nhà cung cấp</td>
                            <td>@(Model.Supplier?.Name ?? "-")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Tổng</td>
                            <td class="fw-bold fs-5">@string.Format("{0:N0}", Model.Total) đ</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="detail-card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-boxes me-2"></i>Sản phẩm nhập</h5></div>
    <div class="p-0 card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">SL</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@(i.Product?.Name ?? ("#" + i.ProductId))</td>
                            <td class="text-end">@string.Format("{0:N0}", i.UnitCost) đ</td>
                            <td class="text-end">@i.Quantity</td>
                            <td class="text-end fw-bold">@string.Format("{0:N0}", i.LineTotal) đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
