@model QuanLyBanHang.Models.Article

@{ ViewData["Title"] = "Xóa bài viết"; }

<div class="page-header">
    <div>
        <h3><i class="bi bi-trash"></i> @ViewData["Title"]</h3>
        <p>Xóa bài viết khỏi hệ thống</p>
    </div>
</div>

<div class="form-card">
    <div class="card-header">
        <h5>Xác nhận xóa</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-danger d-flex align-items-center gap-3 mb-0">
            <i class="bi bi-exclamation-triangle fs-4"></i>
            <div>
                <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa bài viết <strong>@Model.Title</strong>? Hành động này không thể hoàn tác.
            </div>
        </div>

        <dl class="row mt-3 mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>
            <dt class="col-sm-3">Tiêu đề</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            <dt class="col-sm-3">Ngày tạo</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Đang hiển thị" : "Đã tắt")</dd>
            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <dt class="col-sm-3">Hình ảnh</dt>
                <dd class="col-sm-9"><img src="@Model.ImagePath" alt="@Model.Title" style="max-height:100px;border-radius:6px;" /></dd>
            }
        </dl>
    </div>
    <form method="post">
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i> Hủy</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xác nhận xóa</button>
        </div>
    </form>
</div>
