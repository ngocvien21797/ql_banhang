@model QuanLyBanHang.Models.SalesInvoice
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-eye me-2"></i>Đơn @(!string.IsNullOrWhiteSpace(Model.Code) ? Model.Code : $"#{Model.Id}")</h3>
        <p>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="bi bi-trash me-1"></i>Xóa</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="detail-card">
            <div class="card-body">
                <div class="text-muted small">Tổng tiền</div>
                <div class="fs-3 fw-bold">@string.Format("{0:N0}", Model.Total) đ</div>

                <div class="mt-3 d-flex flex-wrap gap-2">
                    <span class="status-badge @(Model.Status=="Completed" ? "success" : Model.Status=="Cancelled" ? "danger" : Model.Status=="Shipped" ? "info" : "secondary")">@SalesInvoice.DisplayStatus(Model.Status)</span>
                    <span class="status-badge @(Model.PaymentStatus=="Paid" ? "success" : Model.PaymentStatus=="Pending" ? "warning" : "secondary")">@SalesInvoice.DisplayPaymentMethod(Model.PaymentMethod) • @SalesInvoice.DisplayPaymentStatus(Model.PaymentStatus)</span>
                </div>

                <hr class="my-3" />

                <form class="mb-3" method="post" asp-action="UpdateStatus">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label class="form-label fw-semibold">Cập nhật trạng thái</label>
                    <select class="form-select mb-2" name="status">
                        @foreach (var st in new[]{"Pending","Confirmed","Shipped","Completed","Cancelled"})
                        {
                            <option value="@st" selected="@(Model.Status==st)">@SalesInvoice.DisplayStatus(st)</option>
                        }
                    </select>
                    <button class="btn btn-dark w-100"><i class="bi bi-save me-1"></i>Lưu trạng thái</button>
                </form>

                @if (Model.PaymentStatus != "Paid")
                {
                    <form method="post" asp-action="MarkPaid">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-success w-100"><i class="bi bi-check2-circle me-1"></i>Đánh dấu đã thanh toán</button>
                    </form>
                }
                else
                {
                    <div class="text-muted small mt-2">
                        <i class="bi bi-check-circle text-success me-1"></i>
                        Đã thanh toán lúc @Model.PaidAt?.ToString("dd/MM/yyyy HH:mm")
                    </div>
                }
            </div>
        </div>

        <div class="detail-card mt-3">
            <div class="card-body">
                <div class="fw-semibold mb-3">Thông tin nhận hàng</div>
                <div class="fw-bold">@Model.ReceiverName</div>
                <div class="text-muted">@Model.ShippingPhone</div>
                <div class="text-muted">@Model.ShippingAddress</div>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="small mt-2 p-2" style="background:#f4f5f8;border-radius:8px;"><i class="bi bi-chat-left-text me-1"></i>@Model.Note</div>
                }
                <hr class="my-2" />
                <div class="small text-muted">
                    Khách hàng: @(Model.Customer?.Name ?? "-") (ID: @(Model.CustomerId?.ToString() ?? "-"))
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="detail-card">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-box me-2"></i>Sản phẩm trong đơn</h5></div>
            <div class="p-0 card-body">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">SL</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@(i.Product?.Name ?? ("#" + i.ProductId))</div>
                                        <div class="small text-muted">@i.Product?.Sku</div>
                                    </td>
                                    <td class="text-end">@string.Format("{0:N0}", i.UnitPrice) đ</td>
                                    <td class="text-end">@i.Quantity</td>
                                    <td class="text-end fw-bold">@string.Format("{0:N0}", i.LineTotal) đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
