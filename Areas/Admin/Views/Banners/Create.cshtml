@model QuanLyBanHang.Models.Banner

@{ ViewData["Title"] = "Thêm banner"; }

<div class="page-header">
    <div>
        <h3><i class="bi bi-plus-circle"></i> @ViewData["Title"]</h3>
        <p>Thêm banner quảng cáo mới</p>
    </div>
</div>

<div class="form-card">
    <div class="card-header">
        <h5>Thông tin banner</h5>
    </div>
    <form method="post" enctype="multipart/form-data">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề..." />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SortOrder" class="form-label"></label>
                    <input asp-for="SortOrder" class="form-control" type="number" />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Hình ảnh</label>
                    <input class="form-control" type="file" name="imageFile" accept="image/*" />
                    <div class="form-text small text-muted">Chấp nhận JPG, JPEG, PNG, WEBP (tối đa 5MB).</div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch mt-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Kích hoạt</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i> Hủy</a>
            <button type="submit" class="btn btn-dark"><i class="bi bi-check-lg me-1"></i> Lưu</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
