@model QuanLyBanHang.Models.Promotion
@{ ViewData["Title"] = "Xóa chương trình khuyến mãi"; }

<div class="page-header">
    <div>
        <h3><i class="bi bi-trash"></i> @ViewData["Title"]</h3>
    </div>
</div>

<div class="form-card">
    <div class="card-header"><h5>Xác nhận xóa</h5></div>
    <div class="card-body">
        <div class="alert alert-danger d-flex align-items-center gap-3 mb-0">
            <i class="bi bi-exclamation-triangle fs-4"></i>
            <div><strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa <strong>@Model.Name</strong>?</div>
        </div>
        <dl class="row mt-3 mb-0">
            <dt class="col-sm-3">Tên</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Mã KM</dt>
            <dd class="col-sm-9"><code>@Model.Code</code></dd>
            <dt class="col-sm-3">Giảm</dt>
            <dd class="col-sm-9">@(Model.DiscountType == "Percentage" ? $"{Model.DiscountValue}%" : Model.DiscountValue.ToString("N0") + "₫")</dd>
            <dt class="col-sm-3">Hiệu lực</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy") → @Model.EndDate.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
    <form method="post">
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i> Hủy</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xác nhận xóa</button>
        </div>
    </form>
</div>
