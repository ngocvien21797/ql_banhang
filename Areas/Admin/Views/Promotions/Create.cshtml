@model QuanLyBanHang.Models.Promotion
@{
    ViewData["Title"] = "Thêm chương trình khuyến mãi";
    var products = ViewBag.Products as List<QuanLyBanHang.Models.Product>;
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-plus-circle"></i> @ViewData["Title"]</h3>
        <p>Tạo chương trình khuyến mãi mới</p>
    </div>
</div>

<div class="form-card">
    <div class="card-header"><h5>Thông tin chương trình</h5></div>
    <form method="post">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Tên chương trình..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label">Mã khuyến mãi</label>
                    <div class="input-group">
                        <input asp-for="Code" class="form-control" placeholder="Để trống để tự động tạo..." id="promoCode" />
                        <button type="button" class="btn btn-outline-secondary" onclick="generateCode()" title="Tạo mã tự động"><i class="bi bi-arrow-repeat"></i></button>
                    </div>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DiscountType" class="form-label">Loại giảm giá</label>
                    <select asp-for="DiscountType" class="form-select">
                        <option value="Percentage">Phần trăm (%)</option>
                        <option value="Fixed">Giảm thẳng (₫)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="DiscountValue" class="form-label">Giá trị giảm</label>
                    <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="MinOrderValue" class="form-label">Đơn tối thiểu</label>
                    <input asp-for="MinOrderValue" class="form-control" type="number" step="1000" min="0" placeholder="Không yêu cầu" />
                </div>
                <div class="col-md-3">
                    <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Mô tả chương trình..."></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label">Kích hoạt ngay</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Áp dụng cho sản phẩm</label>
                    <div class="row g-1" style="max-height:200px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:8px">
                        @if (products != null)
                        {
                            foreach (var p in products)
                            {
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="productIds" value="@p.Id" class="form-check-input" id="prod@(p.Id)" />
                                        <label class="form-check-label small" for="prod@(p.Id)">@p.Name (@p.Sku)</label>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Hủy</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function generateCode() {
            const prefix = 'KM';
            const rand = Math.random().toString(36).substring(2, 8).toUpperCase();
            document.getElementById('promoCode').value = prefix + rand;
        }
    </script>
}
