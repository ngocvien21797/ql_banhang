@model IEnumerable<QuanLyBanHang.Models.Promotion>
@{
    ViewData["Title"] = "Khuyến mãi";
    var pagination = ViewBag.Pagination as QuanLyBanHang.ViewModels.PaginationModel;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-promotions.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-percent"></i> Khuyến mãi</h3>
        <p>Quản lý chương trình khuyến mãi, chiết khấu</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg"></i> Thêm chương trình</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="get" class="filters-bar">
    <div class="form-group">
        <label class="form-label">Tìm kiếm</label>
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Tên, mã khuyến mãi..." value="@Context.Request.Query["search"]" style="width:220px">
    </div>
    <div class="form-group">
        <label class="form-label">Trạng thái</label>
        <select name="status" class="form-select form-select-sm" style="width:150px">
            <option value="">Tất cả</option>
            <option value="active" selected="@(Context.Request.Query["status"] == "active")">Đang chạy</option>
            <option value="expired" selected="@(Context.Request.Query["status"] == "expired")">Hết hạn</option>
            <option value="paused" selected="@(Context.Request.Query["status"] == "paused")">Tạm dừng</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-search"></i> Lọc</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i> Xóa lọc</a>
    </div>
</form>

<div class="card-modern">
    <div class="card-head">
        <h5>Danh sách chương trình khuyến mãi</h5>
        <span class="badge bg-primary">@(pagination?.TotalItems ?? 0)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên chương trình</th>
                        <th>Mã</th>
                        <th>Loại</th>
                        <th class="text-end">Giá trị</th>
                        <th>Hiệu lực</th>
                        <th class="text-center">Sử dụng</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end" style="width:200px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td><code>@item.Code</code></td>
                            <td><span class="usage-badge badge-type">@(item.DiscountType == "Percentage" ? "% Giảm" : "Giảm tiền")</span></td>
                            <td class="text-end fw-semibold">@(item.DiscountType == "Percentage" ? $"{item.DiscountValue}%" : item.DiscountValue.ToString("N0"))</td>
                            <td><small class="text-muted">@item.StartDate.ToString("dd/MM") - @item.EndDate.ToString("dd/MM/yyyy")</small></td>
                            <td class="text-center">
                                @if (item.MaxUsageCount.HasValue)
                                {
                                    var pct = item.MaxUsageCount.Value > 0 ? (int)((double)item.UsageCount / item.MaxUsageCount.Value * 100) : 0;
                                    <div data-bs-toggle="tooltip" title="@item.UsageCount / @item.MaxUsageCount lượt">
                                        <span class="fw-semibold @(pct >= 100 ? "text-danger" : pct >= 80 ? "text-warning" : "")">@item.UsageCount</span>
                                        <small class="text-muted">/@item.MaxUsageCount</small>
                                        <div class="usage-progress-bar">
                                            <div class="usage-progress-fill @(pct >= 100 ? "bg-danger" : pct >= 80 ? "bg-warning" : "bg-success")" style="width:@(Math.Min(pct, 100))%"></div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">@item.UsageCount lượt</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsActive && item.EndDate >= DateTime.Now)
                                {
                                    <span class="status-badge success">Đang chạy</span>
                                }
                                else if (item.EndDate < DateTime.Now)
                                {
                                    <span class="status-badge secondary">Hết hạn</span>
                                }
                                else
                                {
                                    <span class="status-badge warning">Tạm dừng</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="Sửa"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Chưa có chương trình khuyến mãi nào</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (pagination != null && pagination.TotalPages > 1)
    {
        <div class="card-head" style="border-top:1px solid var(--border);border-bottom:none">
            <small class="text-muted">Hiển thị @Model.Count() trên tổng số @pagination.TotalItems</small>
            <partial name="_Pagination" model="pagination" />
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
        });
    </script>
}
