@model IEnumerable<QuanLyBanHang.Areas.Admin.Controllers.ReportsController.TopProductRow>
@{
    ViewData["Title"] = "Top sản phẩm";
    var dataList = Model.ToList();
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-star me-2"></i>Top sản phẩm theo doanh thu</h3>
        <p>Sản phẩm bán chạy nhất trong khoảng thời gian</p>
    </div>
</div>

<!-- Filter -->
<div class="card-modern mb-3">
    <div class="card-head">
        <h5><i class="bi bi-funnel me-2"></i>Bộ lọc</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Từ ngày</label>
                <input class="form-control" type="date" name="from" value="@ViewBag.From" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Đến ngày</label>
                <input class="form-control" type="date" name="to" value="@ViewBag.To" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-dark"><i class="bi bi-funnel me-1"></i>Lọc</button>
            </div>
        </form>
    </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-card-label">Tổng doanh thu top SP</div>
            <div class="stat-card-value">@string.Format("{0:N0}", ViewBag.TotalRevenue) đ</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-card-label">Tổng số lượng bán</div>
            <div class="stat-card-value">@ViewBag.TotalQty</div>
        </div>
    </div>
</div>

<!-- Chart: Horizontal Bar -->
<div class="card-modern mb-3">
    <div class="card-head">
        <h5><i class="bi bi-bar-chart me-2"></i>Biểu đồ top sản phẩm</h5>
    </div>
    <div class="card-body">
        <canvas id="topProductChart" height="@(Math.Max(200, dataList.Count * 35))"></canvas>
    </div>
</div>

<!-- Table -->
<div class="card-table">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Sản phẩm</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Doanh thu</th>
                    <th class="text-end">Tỷ lệ</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var totalRev = ViewBag.TotalRevenue;
                    var idx = 1;
                }
                @foreach (var x in dataList)
                {
                    var pct = totalRev > 0 ? (x.Revenue / totalRev * 100) : 0;
                    <tr>
                        <td class="fw-bold">@idx</td>
                        <td class="fw-semibold">@x.ProductName</td>
                        <td class="text-end">@x.Quantity</td>
                        <td class="text-end fw-semibold">@string.Format("{0:N0}", x.Revenue) đ</td>
                        <td class="text-end">
                            <div class="d-flex align-items-center justify-content-end gap-2">
                                <div style="width:80px;height:6px;background:#e9ecef;border-radius:3px;overflow:hidden;">
                                    <div style="width:@(pct)%;height:100%;background:var(--primary);border-radius:3px;"></div>
                                </div>
                                <span class="small text-muted">@pct.ToString("0.0")%</span>
                            </div>
                        </td>
                    </tr>
                    idx++;
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const productLabels = [@Html.Raw(string.Join(",", dataList.Select(x => "\"" + x.ProductName + "\"")))];
    const productRevenue = [@Html.Raw(string.Join(",", dataList.Select(x => x.Revenue)))];
    const productQty = [@Html.Raw(string.Join(",", dataList.Select(x => x.Quantity)))];

    const colors = [
        'rgba(215,0,24,0.85)', 'rgba(239,68,68,0.8)', 'rgba(249,115,22,0.8)',
        'rgba(245,158,11,0.8)', 'rgba(16,185,129,0.8)', 'rgba(14,165,233,0.8)',
        'rgba(99,102,241,0.8)', 'rgba(139,92,246,0.8)', 'rgba(217,70,239,0.8)',
        'rgba(236,72,153,0.8)'
    ];

    new Chart(document.getElementById('topProductChart'), {
        type: 'bar',
        data: {
            labels: productLabels,
            datasets: [{
                label: 'Doanh thu (VND)',
                data: productRevenue,
                backgroundColor: productRevenue.map((_, i) => colors[i % colors.length]),
                borderRadius: 6,
                borderSkipped: false
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(ctx) {
                            const rev = ctx.raw.toLocaleString('vi-VN') + ' đ';
                            const qty = productQty[ctx.dataIndex];
                            return 'Doanh thu: ' + rev + ' | SL: ' + qty;
                        }
                    }
                }
            },
            scales: {
                x: {
                    ticks: { callback: function(v) { return v.toLocaleString('vi-VN'); } }
                }
            }
        }
    });
</script>
