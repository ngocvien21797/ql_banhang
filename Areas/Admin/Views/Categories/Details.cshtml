@model QuanLyBanHang.Models.Category

@{ ViewData["Title"] = "Chi tiết danh mục"; }

<div class="page-header">
    <div>
        <h3><i class="bi bi-info-circle"></i> @ViewData["Title"]</h3>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="detail-card">
            <div class="detail-header">
                <h5>Thông tin cơ bản</h5>
            </div>
            <div class="detail-body">
                <div class="detail-row">
                    <div class="detail-label">ID</div>
                    <div class="detail-value">@Model.Id</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Tên</div>
                    <div class="detail-value">@Model.Name</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Số sản phẩm</div>
                    <div class="detail-value"><span class="badge bg-info">@Model.Products.Count</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        @if (Model.Products.Any())
        {
            <div class="card-modern">
                <div class="card-head">
                    <h5><i class="bi bi-box-seam me-2"></i>Sản phẩm trong danh mục</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>Tên</th>
                                    <th class="text-end">Giá</th>
                                    <th class="text-end">Tồn</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products)
                                {
                                    <tr>
                                        <td class="fw-semibold">@p.Sku</td>
                                        <td>@p.Name</td>
                                        <td class="text-end">@string.Format("{0:N0}", p.Price) đ</td>
                                        <td class="text-end">@p.Stock</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
