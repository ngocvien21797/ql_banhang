@model QuanLyBanHang.Models.Category

@{ ViewData["Title"] = "Chi tiết danh mục"; }

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-categories.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-info-circle"></i> @ViewData["Title"]</h3>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="cat-detail row g-4">
    <div class="col-lg-4">
        <div class="profile-card">
            <div class="profile-head">
                <i class="bi bi-tags"></i>
            </div>
            <div class="profile-body">
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-hash me-1"></i> Mã danh mục</span>
                    <span class="info-value">#@Model.Id</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-tag me-1"></i> Tên danh mục</span>
                    <span class="info-value">@Model.Name</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-box me-1"></i> Số sản phẩm</span>
                    <span class="info-value"><span class="badge bg-info rounded-pill">@Model.Products.Count</span></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="stat-grid">
            <div class="stat-box">
                <div class="stat-icon products"><i class="bi bi-box-seam"></i></div>
                <div class="stat-num">@Model.Products.Count</div>
                <div class="stat-label">Sản phẩm</div>
            </div>
            <div class="stat-box">
                <div class="stat-icon stock"><i class="bi bi-cubes"></i></div>
                <div class="stat-num">@Model.Products.Sum(p => p.Stock).ToString("N0")</div>
                <div class="stat-label">Tổng tồn kho</div>
            </div>
            <div class="stat-box">
                <div class="stat-icon value"><i class="bi bi-coin"></i></div>
                <div class="stat-num">@Model.Products.Sum(p => p.Price * p.Stock).ToString("N0") đ</div>
                <div class="stat-label">Giá trị kho</div>
            </div>
        </div>

        @if (Model.Products.Any())
        {
            <div class="card-modern mt-3">
                <div class="card-head">
                    <h5><i class="bi bi-box-seam me-2"></i>Sản phẩm trong danh mục</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>Tên</th>
                                    <th class="text-end">Giá</th>
                                    <th class="text-end">Tồn</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products)
                                {
                                    <tr>
                                        <td class="fw-semibold">@p.Sku</td>
                                        <td>@p.Name</td>
                                        <td class="text-end">@string.Format("{0:N0}", p.Price) đ</td>
                                        <td class="text-end">@p.Stock</td>
                                        <td class="text-end fw-semibold text-success">@string.Format("{0:N0}", p.Price * p.Stock) đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle"></i> Danh mục này chưa có sản phẩm nào.
            </div>
        }
    </div>
</div>
