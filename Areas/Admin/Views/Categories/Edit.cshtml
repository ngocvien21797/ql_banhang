@model QuanLyBanHang.Models.Category

@{ ViewData["Title"] = "Sửa danh mục"; }

<div class="page-header">
    <div>
        <h3><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h3>
        <p>Cập nhật thông tin danh mục</p>
    </div>
</div>

<div class="form-card">
    <div class="card-header">
        <h5>Thông tin danh mục</h5>
    </div>
    <form method="post">
        <input asp-for="Id" type="hidden" />
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Hủy</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
