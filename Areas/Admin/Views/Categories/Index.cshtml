@model IEnumerable<QuanLyBanHang.Areas.Admin.Controllers.CategoriesController.CategoryViewModel>

@{
    ViewData["Title"] = "Danh mục";
    var pagination = ViewBag.Pagination as QuanLyBanHang.ViewModels.PaginationModel;
    var count = Model.Count();
    var catIcons = new[] { "blue", "green", "orange", "purple", "pink", "teal" };
    var catIconClasses = new[] { "bi-box", "bi-box-seam", "bi-archive", "bi-stack", "bi-layers", "bi-grid" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-categories.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-tags"></i> Danh mục</h3>
        <p>Quản lý danh mục sản phẩm</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg"></i> Thêm danh mục</a>
    </div>
</div>

<form method="get" class="filters-bar">
    <div class="form-group">
        <label class="form-label">Tìm kiếm</label>
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo tên danh mục..." value="@Context.Request.Query["search"]" style="width:200px">
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-search"></i> Lọc</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i> Xóa lọc</a>
    </div>
</form>

<div class="card-modern">
    <div class="card-head">
        <h5>Danh sách danh mục</h5>
        <span class="badge bg-primary">@(pagination?.TotalItems ?? 0)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0 cat-table">
                <thead>
                    <tr>
                        <th>Danh mục</th>
                        <th class="text-center">Số SP</th>
                        <th class="text-end">Tồn kho</th>
                        <th class="text-end">Giá trị kho</th>
                        <th class="text-end" style="width:280px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idx = 0;
                    }
                    @foreach(var item in Model) {
                        var ci = catIcons[idx % catIcons.Length];
                        var ic = catIconClasses[idx % catIconClasses.Length];
                        idx++;
                        <tr>
                            <td>
                                <div class="cat-cell">
                                    <div class="cat-icon @ci"><i class="@ic"></i></div>
                                    <div class="cat-info">
                                        <h6>@item.Name</h6>
                                        <small>Mã: @item.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info rounded-pill">@item.ProductCount</span>
                            </td>
                            <td class="text-end"><span class="stock-num">@item.TotalStock.ToString("N0")</span></td>
                            <td class="text-end"><span class="value-num">@item.TotalValue.ToString("N0") đ</span></td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Xem"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="Sửa"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (pagination != null && pagination.TotalPages > 1)
    {
        <div class="card-head" style="border-top:1px solid var(--border);border-bottom:none">
            <small class="text-muted">Hiển thị @count trên tổng số @pagination.TotalItems mục</small>
            <partial name="_Pagination" model="pagination" />
        </div>
    }
</div>
