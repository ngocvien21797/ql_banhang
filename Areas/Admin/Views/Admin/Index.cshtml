@using QuanLyBanHang.Models
@{
    ViewData["Title"] = "Dashboard";
    var lowStock = ViewBag.LowStock as List<Product> ?? new List<Product>();
    var recentOrders = ViewBag.RecentOrders as List<SalesInvoice> ?? new List<SalesInvoice>();

    string Trend(decimal cur, decimal prev)
    {
        if (prev == 0) return cur > 0 ? "+100%" : "0%";
        var pct = (cur - prev) / prev * 100;
        return (pct >= 0 ? "+" : "") + pct.ToString("0.0") + "%";
    }
    string TrendClass(decimal cur, decimal prev) => cur >= prev ? "up" : "down";
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-speedometer2 me-2"></i>Dashboard</h3>
        <p>Tổng quan hoạt động kinh doanh</p>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-top">
                <div>
                    <div class="stat-card-label">Sản phẩm</div>
                    <div class="stat-card-value">@ViewBag.ProductCount</div>
                </div>
                <div class="stat-card-icon blue"><i class="bi bi-box-seam"></i></div>
            </div>
            <a class="stat-card-action" asp-controller="Products" asp-action="Index">Quản lý <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-top">
                <div>
                    <div class="stat-card-label">Khách hàng</div>
                    <div class="stat-card-value">@ViewBag.CustomerCount</div>
                </div>
                <div class="stat-card-icon green"><i class="bi bi-people"></i></div>
            </div>
            <a class="stat-card-action" asp-controller="Customers" asp-action="Index">Quản lý <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-top">
                <div>
                    <div class="stat-card-label">Đơn hôm nay</div>
                    <div class="stat-card-value">@ViewBag.OrdersToday</div>
                </div>
                <div class="stat-card-icon orange"><i class="bi bi-receipt"></i></div>
            </div>
            <div class="stat-card-trend @TrendClass(ViewBag.OrdersToday, ViewBag.OrdersYesterday)">
                <i class="bi bi-arrow-@(ViewBag.OrdersToday >= ViewBag.OrdersYesterday ? "up" : "down")"></i>
                @Trend(ViewBag.OrdersToday, ViewBag.OrdersYesterday) so với hôm qua
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-top">
                <div>
                    <div class="stat-card-label">Doanh thu hôm nay</div>
                    <div class="stat-card-value">@string.Format("{0:N0}", ViewBag.RevenueToday) đ</div>
                </div>
                <div class="stat-card-icon purple"><i class="bi bi-cash-coin"></i></div>
            </div>
            <div class="stat-card-trend @TrendClass(ViewBag.RevenueToday, ViewBag.RevenueYesterday)">
                <i class="bi bi-arrow-@(ViewBag.RevenueToday >= ViewBag.RevenueYesterday ? "up" : "down")"></i>
                @Trend(ViewBag.RevenueToday, ViewBag.RevenueYesterday) so với hôm qua
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-modern">
            <div class="card-head">
                <h5><i class="bi bi-graph-up"></i> Doanh thu 7 ngày</h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-modern">
            <div class="card-head">
                <h5><i class="bi bi-pie-chart"></i> Doanh thu theo DM</h5>
            </div>
            <div class="card-body">
                <canvas id="categoryChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card-modern">
            <div class="card-head">
                <h5><i class="bi bi-trophy"></i> Top 5 sản phẩm (30 ngày)</h5>
            </div>
            <div class="card-body">
                <canvas id="topProductsChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-modern">
            <div class="card-head">
                <h5><i class="bi bi-bar-chart"></i> Số đơn hàng 7 ngày</h5>
            </div>
            <div class="card-body">
                <canvas id="orderCountChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-head">
                <h5><i class="bi bi-receipt-cutoff me-2"></i>Đơn mới nhất</h5>
                <span class="status-badge warning">Chưa TT: @ViewBag.UnpaidCount</span>
            </div>
            <div class="card-body p-0">
                @if (recentOrders.Count == 0)
                {
                    <div class="text-muted p-4">Chưa có đơn hàng.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Mã</th>
                                    <th>Khách</th>
                                    <th>Ngày</th>
                                    <th>TT</th>
                                    <th class="text-end">Tổng</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var o in recentOrders)
                            {
                                <tr>
                                    <td class="fw-semibold">@(!string.IsNullOrWhiteSpace(o.Code) ? o.Code : $"#{o.Id}")</td>
                                    <td class="small">@(o.Customer?.Name ?? "Khách lẻ")</td>
                                    <td class="small">@o.CreatedAt.ToString("dd/MM HH:mm")</td>
                                    <td>
                                        <span class="status-badge @(o.PaymentStatus=="Paid" ? "success" : o.PaymentStatus=="Pending" ? "warning" : "secondary")">@SalesInvoice.DisplayPaymentStatus(o.PaymentStatus)</span>
                                    </td>
                                    <td class="text-end fw-semibold">@string.Format("{0:N0}", o.Total) đ</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-head">
                <h5><i class="bi bi-exclamation-triangle me-2"></i>Sắp hết hàng</h5>
                <a class="btn btn-ghost btn-sm" asp-controller="Inventory" asp-action="Stock">Xem kho</a>
            </div>
            <div class="card-body">
                @if (lowStock.Count == 0)
                {
                    <div class="text-muted">Không có sản phẩm sắp hết hàng.</div>
                }
                else
                {
                    <div class="vstack gap-2">
                    @foreach (var p in lowStock)
                    {
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background:#fafbfc;">
                            <div>
                                <div class="fw-semibold">@p.Name</div>
                                <div class="small text-muted">@p.Sku</div>
                            </div>
                            <span class="status-badge danger">Còn @p.Stock</span>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card-modern mt-3">
    <div class="card-head">
        <h5><i class="bi bi-lightning-charge me-2"></i>Tác vụ nhanh</h5>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-dark" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm</a>
            <a class="btn btn-outline-secondary" asp-controller="Purchases" asp-action="Create"><i class="bi bi-cart-plus me-1"></i>Nhập hàng</a>
            <a class="btn btn-outline-secondary" asp-controller="Sales" asp-action="Create"><i class="bi bi-receipt me-1"></i>Tạo đơn bán</a>
            <a class="btn btn-outline-secondary" asp-controller="Sales" asp-action="Index"><i class="bi bi-list me-1"></i>Quản lý đơn</a>
            <a class="btn btn-outline-secondary" asp-controller="Reports" asp-action="RevenueByDate"><i class="bi bi-bar-chart me-1"></i>Báo cáo</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const colors = ['#d70018','#2563eb','#10b981','#f59e0b','#8b5cf6','#ec4899','#06b6d4'];

        // Revenue chart
        var ctx1 = document.getElementById('revenueChart');
        if (ctx1) {
            new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                    datasets: [{
                        label: 'Doanh thu (₫)',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartData)),
                        backgroundColor: 'rgba(215,0,24,0.7)',
                        borderColor: '#d70018',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { callback: v => (v/1000).toLocaleString()+'k' } }
                    }
                }
            });
        }

        // Category pie chart
        var ctx2 = document.getElementById('categoryChart');
        if (ctx2) {
            var catData = @Html.Raw(Json.Serialize(ViewBag.RevenueByCategory));
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: catData.map(d => d.category),
                    datasets: [{
                        data: catData.map(d => d.total),
                        backgroundColor: colors.slice(0, catData.length),
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        }

        // Top products bar chart
        var ctx3 = document.getElementById('topProductsChart');
        if (ctx3) {
            var topData = @Html.Raw(Json.Serialize(ViewBag.TopProducts));
            new Chart(ctx3, {
                type: 'bar',
                data: {
                    labels: topData.map(d => d.name),
                    datasets: [
                        {
                            label: 'SL',
                            data: topData.map(d => d.qty),
                            backgroundColor: 'rgba(37,99,235,0.7)',
                            borderRadius: 4,
                            order: 2
                        },
                        {
                            label: 'Doanh thu',
                            data: topData.map(d => d.revenue),
                            backgroundColor: 'rgba(215,0,24,0.7)',
                            borderRadius: 4,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } } },
                    scales: {
                        y: { beginAtZero: true },
                        x: { ticks: { font: { size: 10 } } }
                    }
                }
            });
        }

        // Order count chart
        var ctx4 = document.getElementById('orderCountChart');
        if (ctx4) {
            new Chart(ctx4, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                    datasets: [{
                        label: 'Đơn hàng',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartCounts)),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16,185,129,0.1)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });
        }
    </script>
}
