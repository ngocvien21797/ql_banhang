@model IEnumerable<QuanLyBanHang.Models.StockLedger>
@{
    ViewData["Title"] = "Nhật ký kho";
    var pagination = ViewBag.Pagination as QuanLyBanHang.ViewModels.PaginationModel;
    var count = Model.Count();
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-journal-text me-2"></i>Nhật ký kho</h3>
        <p>Lịch sử xuất nhập tồn kho</p>
    </div>
</div>

<div class="card-modern mb-3">
    <div class="card-head">
        <h5><i class="bi bi-funnel me-2"></i>Bộ lọc</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Từ ngày</label>
                <input class="form-control" type="date" name="from" value="@ViewBag.From" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Đến ngày</label>
                <input class="form-control" type="date" name="to" value="@ViewBag.To" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-dark"><i class="bi bi-funnel me-1"></i>Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-card-label">Tổng nhập (IN)</div>
            <div class="stat-card-value text-success">+@ViewBag.TotalIn</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-card-label">Tổng xuất (OUT)</div>
            <div class="stat-card-value text-danger">-@ViewBag.TotalOut</div>
        </div>
    </div>
</div>

<div class="card-table">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Sản phẩm</th>
                    <th>Loại</th>
                    <th class="text-end">SL</th>
                    <th>Tham chiếu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.OccurredAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-semibold">@(x.Product?.Name ?? ("#" + x.ProductId))</td>
                        <td>
                            @if (x.Type == "IN")
                            {
                                <span class="status-badge success">Nhập kho</span>
                            }
                            else if (x.Type == "OUT")
                            {
                                <span class="status-badge danger">Xuất kho</span>
                            }
                            else
                            {
                                <span class="status-badge secondary">@x.Type</span>
                            }
                        </td>
                        <td class="text-end fw-bold @(x.Type == "IN" ? "text-success" : "text-danger")">
                            @(x.Type == "IN" ? "+" : "-")@x.Quantity
                        </td>
                        <td>
                            <span class="badge bg-secondary">@x.RefType</span> #@x.RefId
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pagination != null && pagination.TotalPages > 1)
    {
        <div class="card-head" style="border-top:1px solid var(--border);border-bottom:none">
            <small class="text-muted">Hiển thị @count trên tổng số @pagination.TotalItems mục</small>
            <partial name="_Pagination" model="pagination" />
        </div>
    }
</div>
