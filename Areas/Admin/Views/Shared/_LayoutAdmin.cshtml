@using System.Security.Claims
@{
    var username = User.Identity?.Name ?? "admin";
    var roleName = User.IsInRole("1") ? "Admin" : "Nhân viên";
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string c, string? a = null) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) && (a == null || string.Equals(act, a, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="admin">
<div class="admin-shell">
    <!-- Sidebar -->
    <div class="offcanvas-md offcanvas-start admin-sidebar" tabindex="-1" id="adminSidebar">
        <div class="d-md-none px-3 pt-3 d-flex justify-content-between align-items-center">
            <span class="text-white fw-bold fs-6">Menu</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>

        <a class="admin-brand" asp-area="Admin" asp-controller="Admin" asp-action="Index">
            <span class="admin-brand-icon"><i class="bi bi-bag-check-fill"></i></span>
            <span class="admin-brand-text">QL Bán Hàng</span>
        </a>

        <div class="admin-nav-label">Quản trị</div>
        <nav class="admin-nav">
            <a class="nav-link @(IsActive("Admin") ? "active" : "")" asp-area="Admin" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
            <a class="nav-link @(IsActive("Sales") ? "active" : "")" asp-area="Admin" asp-controller="Sales" asp-action="Index"><i class="bi bi-receipt"></i>Đơn hàng</a>
            <a class="nav-link @(IsActive("Products") ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i>Sản phẩm</a>
            <a class="nav-link @(IsActive("Categories") ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i>Danh mục</a>
            <a class="nav-link @(IsActive("Customers") ? "active" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i>Khách hàng</a>
        </nav>

        <div class="admin-nav-label">Kho & Báo cáo</div>
        <nav class="admin-nav">
            <a class="nav-link @(IsActive("Inventory") && act == "Stock" ? "active" : "")" asp-area="Admin" asp-controller="Inventory" asp-action="Stock"><i class="bi bi-boxes"></i>Tồn kho</a>
            <a class="nav-link @(IsActive("Inventory") && act == "Ledger" ? "active" : "")" asp-area="Admin" asp-controller="Inventory" asp-action="Ledger"><i class="bi bi-journal-text"></i>Nhật ký kho</a>
            <a class="nav-link @(IsActive("Reports") && act == "RevenueByDate" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="RevenueByDate"><i class="bi bi-bar-chart"></i>Doanh thu</a>
            <a class="nav-link @(IsActive("Reports") && act == "TopProducts" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="TopProducts"><i class="bi bi-star"></i>Top sản phẩm</a>
        </nav>

        <nav class="admin-nav">
            <a class="nav-link @(IsActive("Promotions") ? "active" : "")" asp-area="Admin" asp-controller="Promotions" asp-action="Index"><i class="bi bi-percent"></i>Khuyến mãi</a>
        </nav>

        <div class="admin-nav-label">Nội dung</div>
        <nav class="admin-nav">
            <a class="nav-link @(IsActive("Banners") ? "active" : "")" asp-area="Admin" asp-controller="Banners" asp-action="Index"><i class="bi bi-images"></i>Banner</a>
            <a class="nav-link @(IsActive("Articles") ? "active" : "")" asp-area="Admin" asp-controller="Articles" asp-action="Index"><i class="bi bi-newspaper"></i>Bài viết</a>

        </nav>

        <div class="admin-sidebar-user">
            <div class="admin-sidebar-user-avatar"><i class="bi bi-person"></i></div>
            <span class="admin-sidebar-user-name">@username</span>
            <a class="admin-sidebar-user-logout" asp-area="" asp-controller="Account" asp-action="Logout" title="Đăng xuất"><i class="bi bi-box-arrow-right"></i></a>
        </div>
    </div>

    <!-- Main -->
    <div class="flex-grow-1 d-flex flex-column min-vh-100">
        <!-- Topbar -->
        <div class="admin-topbar">
            <div class="admin-topbar-left">
                <button class="btn btn-ghost btn-sm d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
                    <i class="bi bi-list fs-5"></i>
                </button>

            </div>
            <div class="admin-topbar-right">
                <button class="admin-topbar-btn" title="Thông báo" type="button">
                    <i class="bi bi-bell"></i>
                </button>
                <div class="dropdown admin-user-dropdown">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="admin-user-avatar-sm">@username[..1].ToUpper()</span>
                        <div class="d-none d-md-block text-start">
                            <div class="admin-user-name-sm">@username</div>
                            <div class="admin-user-role-sm">@roleName</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size:11px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width:200px;border-radius:10px;border:1px solid var(--border);padding:6px;">
                        <li><h6 class="dropdown-header">Tài khoản</h6></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Content -->
        <main class="container-fluid py-3 flex-grow-1">
            @RenderBody()
        </main>

        <!-- Footer -->
        <div class="admin-footer">
            <span>&copy; @DateTime.Now.Year - Quản Lý Bán Hàng</span>
            <span>v1.0</span>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8/dist/browser/signalr.min.js"></script>
<script>
    (function() {
        try {
            const conn = new signalR.HubConnectionBuilder()
                .withUrl('/hub/orders')
                .withAutomaticReconnect()
                .build();

            conn.on('OrderStatusChanged', function(orderId, newStatus) {
                const badge = document.querySelector('#order-' + orderId + ' .status-badge');
                if (badge) {
                    badge.className = 'status-badge ' + (newStatus === 'Completed' ? 'success' : newStatus === 'Cancelled' ? 'danger' : 'warning');
                    badge.textContent = newStatus === 'Completed' ? 'Hoàn thành' : newStatus === 'Cancelled' ? 'Đã hủy' : newStatus;
                }
                // Also update any inline status display
                document.querySelectorAll('[data-order-id="' + orderId + '"]').forEach(function(el) {
                    if (el.dataset.orderStatus !== undefined) {
                        el.textContent = newStatus === 'Completed' ? 'Hoàn thành' : newStatus === 'Cancelled' ? 'Đã hủy' : newStatus;
                        el.dataset.orderStatus = newStatus;
                    }
                });
            });

            conn.start().catch(function(err) {
                console.warn('SignalR connection failed:', err.toString());
            });
        } catch(e) {}
    })();
</script>

@RenderSection("Scripts", required: false)
</body>
</html>
