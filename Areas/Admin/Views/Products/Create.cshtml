@model QuanLyBanHang.Models.Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-products.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm</h3>
        <p>Thêm sản phẩm mới vào hệ thống</p>
    </div>
</div>

<div class="form-card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Thông tin sản phẩm</h5></div>
    <form method="post" enctype="multipart/form-data" asp-action="Create">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Ảnh sản phẩm</label>
                    <input class="form-control" type="file" name="imageFile" accept="image/*" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">SKU</label>
                    <input class="form-control" asp-for="Sku" />
                    <span class="text-danger" asp-validation-for="Sku"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Thương hiệu</label>
                    <input class="form-control" asp-for="Brand" placeholder="VD: Samsung, Apple..." />
                    <span class="text-danger" asp-validation-for="Brand"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tên sản phẩm</label>
                    <input class="form-control" asp-for="Name" />
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Danh mục</label>
                    <select class="form-select" asp-for="CategoryId" asp-items="ViewBag.Categories">
                        <option value="">-- Chọn --</option>
                    </select>
                    <span class="text-danger" asp-validation-for="CategoryId"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Giá</label>
                    <input class="form-control" asp-for="Price" />
                    <span class="text-danger" asp-validation-for="Price"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tồn kho</label>
                    <input class="form-control" asp-for="Stock" />
                    <span class="text-danger" asp-validation-for="Stock"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bảo hành (tháng)</label>
                    <input class="form-control" asp-for="WarrantyMonths" min="0" />
                    <span class="text-danger" asp-validation-for="WarrantyMonths"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-select" asp-for="IsActive" onchange="colorStatusSelect(this)">
                        <option value="true" style="background:#d4edda;color:#000;">Đang bán</option>
                        <option value="false" style="background:#f8d7da;color:#000;">Ngừng bán</option>
                    </select>
                </div>
                <div class="col-12 product-desc-wrap">
                    <label class="form-label"><i class="bi bi-info-circle me-1"></i>Giới thiệu sản phẩm</label>
                    <textarea class="form-control" asp-for="Description" rows="6" placeholder="Nhập nội dung giới thiệu sản phẩm..."></textarea>
                    <div class="product-desc-hint">Nội dung này sẽ hiển thị ở trang chi tiết sản phẩm cho khách hàng.</div>
                </div>
                <div class="col-12 product-specs-wrap">
                    <label class="form-label">Thông số kỹ thuật</label>
                    <div class="specs-builder" id="specsBuilder">
                        <div class="specs-builder-header">
                            <span>Tên thông số</span>
                            <span>Giá trị</span>
                            <span></span>
                        </div>
                        <div id="specsRows">
                            <div class="specs-row">
                                <input class="specs-input" name="specLabels" placeholder="VD: Màn hình" />
                                <input class="specs-input" name="specValues" placeholder="VD: 6.7 inch" />
                                <button type="button" class="specs-remove-btn" onclick="removeSpecRow(this)" title="Xoá"><i class="bi bi-x"></i></button>
                            </div>
                        </div>
                        <button type="button" class="specs-add-btn" onclick="addSpecRow()"><i class="bi bi-plus-lg"></i>Thêm thông số</button>
                    </div>
                    <input type="hidden" asp-for="Specifications" id="specsJson" />
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-x-lg me-1"></i>Hủy</a>
            <button class="btn btn-dark"><i class="bi bi-check-lg me-1"></i>Lưu</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function colorStatusSelect(el) {
            var opt = el.options[el.selectedIndex];
            el.style.background = opt.style.background;
            el.style.color = '#000';
        }
        colorStatusSelect(document.getElementById('@Html.IdFor(m => m.IsActive)'));

        function addSpecRow() {
            var div = document.createElement('div');
            div.className = 'specs-row';
            div.innerHTML = '<input class="specs-input" name="specLabels" placeholder="Tên thông số" />' +
                '<input class="specs-input" name="specValues" placeholder="Giá trị" />' +
                '<button type="button" class="specs-remove-btn" onclick="removeSpecRow(this)" title="Xo\u00e1"><i class="bi bi-x"></i></button>';
            document.getElementById('specsRows').appendChild(div);
        }
        function removeSpecRow(btn) {
            var rows = document.getElementById('specsRows');
            if (rows.children.length <= 1) return;
            btn.closest('.specs-row').remove();
        }
        document.getElementById('specsBuilder').closest('form').addEventListener('submit', function() {
            var rows = document.querySelectorAll('#specsRows .specs-row');
            var specs = [];
            rows.forEach(function(row) {
                var label = row.querySelector('input[name="specLabels"]').value.trim();
                var value = row.querySelector('input[name="specValues"]').value.trim();
                if (label || value) {
                    specs.push({ label: label, value: value });
                }
            });
            document.getElementById('specsJson').value = JSON.stringify(specs);
        });
    </script>
}
