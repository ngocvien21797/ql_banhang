@model QuanLyBanHang.Models.Product
@using System.Text.Json
@{
    ViewData["Title"] = "Chi tiết sản phẩm";

    string? imgSrc = null;
    if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        var p = Model.ImagePath.Trim();
        if (p.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            p.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            p.StartsWith("/"))
            imgSrc = p;
        else
            imgSrc = "/" + p;
    }

    List<Dictionary<string, string>> specs = new();
    if (!string.IsNullOrWhiteSpace(Model.Specifications))
    {
        try { specs = JsonSerializer.Deserialize<List<Dictionary<string, string>>>(Model.Specifications) ?? new(); }
        catch { }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-products.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-eye me-2"></i>Chi tiết sản phẩm</h3>
        <p>@Model.Name</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<div class="form-card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Thông tin sản phẩm</h5></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Ảnh sản phẩm</label>
                @if (!string.IsNullOrWhiteSpace(imgSrc))
                {
                    <div class="detail-img-wrapper">
                        <img src="@imgSrc" alt="@Model.Name" />
                    </div>
                    <div class="detail-img-link mt-1">
                        <a href="@imgSrc" target="_blank">Mở ảnh tab mới <i class="bi bi-box-arrow-up-right"></i></a>
                    </div>
                }
                else
                {
                    <div class="detail-img-placeholder">
                        <i class="bi bi-image"></i>
                        <div>Chưa có ảnh</div>
                    </div>
                }
            </div>
            <div class="col-md-3">
                <label class="form-label">SKU</label>
                <div class="detail-field-value">@Model.Sku</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Thương hiệu</label>
                <div class="detail-field-value">@(!string.IsNullOrWhiteSpace(Model.Brand) ? Model.Brand : "-")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Tên sản phẩm</label>
                <div class="detail-field-value">@Model.Name</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Danh mục</label>
                <div class="detail-field-value">@(Model.Category?.Name ?? "-")</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Giá</label>
                <div class="detail-field-value">@string.Format("{0:N0}", Model.Price) đ</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Tồn kho</label>
                <div class="detail-field-value">@Model.Stock</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Bảo hành (tháng)</label>
                <div class="detail-field-value">@(Model.WarrantyMonths > 0 ? $"{Model.WarrantyMonths} tháng" : "Không")</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Trạng thái</label>
                <div class="detail-field-value @(Model.IsActive ? "status-active" : "status-inactive")">
                    <i class="bi @(Model.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                    @(Model.IsActive ? "Đang bán" : "Ngừng bán")
                </div>
            </div>
            <div class="col-12 product-desc-wrap">
                <label class="form-label"><i class="bi bi-info-circle me-1"></i>Giới thiệu sản phẩm</label>
                <div class="detail-field-value" style="white-space:pre-line;line-height:1.8;">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "Chưa có mô tả")</div>
            </div>
            <div class="col-12 product-specs-wrap">
                <label class="form-label">Thông số kỹ thuật</label>
                @if (specs.Count > 0)
                {
                    <table class="detail-specs-table">
                        <tbody>
                            @foreach (var spec in specs)
                            {
                                <tr>
                                    <td class="detail-specs-label">@spec.GetValueOrDefault("label", "")</td>
                                    <td class="detail-specs-value">@spec.GetValueOrDefault("value", "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-muted">Chưa có thông số kỹ thuật</div>
                }
            </div>
        </div>
    </div>
    <div class="card-footer">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
        <a class="btn btn-dark" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Sửa sản phẩm</a>
    </div>
</div>
