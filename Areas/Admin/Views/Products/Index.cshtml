@model IEnumerable<QuanLyBanHang.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm";
    var isAdmin = User.IsInRole("1");
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-box me-2"></i>Sản phẩm</h3>
        <p>Quản lý danh sách sản phẩm</p>
    </div>
    @if (isAdmin)
    {
        <div class="page-actions">
            <a class="btn btn-dark" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm</a>
        </div>
    }
</div>

<form method="get" class="filters-bar">
    <div class="form-group">
        <label class="form-label">Tìm kiếm</label>
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo tên, SKU..." value="@Context.Request.Query["search"]" style="width:200px">
    </div>
    <div class="form-group">
        <label class="form-label">Danh mục</label>
        <select name="categoryId" class="form-select form-select-sm" style="width:180px">
            <option value="">-- Tất cả danh mục --</option>
            @if (ViewBag.Categories is SelectList cats)
            {
                foreach (var c in cats)
                {
                    <option value="@c.Value" selected="@(Context.Request.Query["categoryId"] == c.Value)">@c.Text</option>
                }
            }
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-search"></i> Lọc</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i> Xóa lọc</a>
    </div>
</form>

<div class="form-card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-table me-2"></i>Danh sách sản phẩm</h5></div>
    <div class="p-0 card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:80px">Ảnh</th>
                        <th>SKU</th>
                        <th>Tên</th>
                        <th>Danh mục</th>
                        <th class="text-end">Giá</th>
                        <th class="text-end">Tồn</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end" style="width:200px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var rowClass = p.Stock <= 5 ? "table-danger" : p.Stock <= 20 ? "table-warning" : "";
                        <tr class="@rowClass">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                                {
                                    <img src="@p.ImagePath" alt="@p.Name" style="width:80px;height:56px;object-fit:cover;border-radius:10px;border:1px solid var(--border);" />
                                }
                                else
                                {
                                    <span class="text-muted small">No image</span>
                                }
                            </td>
                            <td class="fw-semibold">@p.Sku</td>
                            <td>@p.Name</td>
                            <td>@(p.Category?.Name ?? "-")</td>
                            <td class="text-end">@string.Format("{0:N0}", p.Price)</td>
                            <td class="text-end">@p.Stock</td>
                            <td class="text-center">
                                @if (p.IsActive)
                                {
                                    <span class="status-badge success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="status-badge secondary">Ngừng bán</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-eye me-1"></i>Xem</a>
                                @if (isAdmin)
                                {
                                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil me-1"></i>Sửa</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id"><i class="bi bi-trash me-1"></i>Xóa</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <partial name="_Pagination" model="ViewBag.Pagination" />
    </div>
</div>
