@model QuanLyBanHang.Models.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-pencil me-2"></i>Sửa sản phẩm</h3>
        <p>Cập nhật thông tin sản phẩm</p>
    </div>
</div>

<div class="form-card">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Thông tin sản phẩm</h5></div>
    <form method="post" enctype="multipart/form-data" asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImagePath" />
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Ảnh sản phẩm</label>
                    <input class="form-control" type="file" name="imageFile" accept="image/*" />
                    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                    {
                        <div class="mt-2">
                            <div class="small text-muted mb-1">Ảnh hiện tại</div>
                            <img src="@Model.ImagePath" alt="@Model.Name"
                                 style="max-width:220px;height:auto;border-radius:10px;border:1px solid var(--border);" />
                        </div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">SKU</label>
                    <input class="form-control" asp-for="Sku" />
                    <span class="text-danger" asp-validation-for="Sku"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Thương hiệu</label>
                    <input class="form-control" asp-for="Brand" placeholder="VD: Samsung, Apple..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tên sản phẩm</label>
                    <input class="form-control" asp-for="Name" />
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Danh mục</label>
                    <select class="form-select" asp-for="CategoryId" asp-items="ViewBag.Categories">
                        <option value="">-- Chọn --</option>
                    </select>
                    <span class="text-danger" asp-validation-for="CategoryId"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Giá</label>
                    <input class="form-control" asp-for="Price" />
                    <span class="text-danger" asp-validation-for="Price"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tồn kho</label>
                    <input class="form-control" asp-for="Stock" />
                    <span class="text-danger" asp-validation-for="Stock"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bảo hành (tháng)</label>
                    <input class="form-control" asp-for="WarrantyMonths" min="0" />
                </div>
                <div class="col-md-3 d-flex align-items-end pb-2">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label fw-semibold" asp-for="IsActive">Đang bán</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Mô tả</label>
                    <textarea class="form-control" asp-for="Description" rows="3" placeholder="Mô tả sản phẩm..."></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Thông số kỹ thuật (JSON)</label>
                    <textarea class="form-control" asp-for="Specifications" rows="3" placeholder='VD: {"Màn hình":"6.7 inch","RAM":"8GB","ROM":"256GB"}'></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-x-lg me-1"></i>Hủy</a>
            <button class="btn btn-dark"><i class="bi bi-check-lg me-1"></i>Lưu</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
