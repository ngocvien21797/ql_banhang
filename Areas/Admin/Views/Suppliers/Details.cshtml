@model QuanLyBanHang.Models.Supplier

@{ ViewData["Title"] = "Chi tiết nhà cung cấp"; }

<div class="page-header">
    <div>
        <h3><i class="bi bi-info-circle"></i> @ViewData["Title"]</h3>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="detail-card">
            <div class="detail-header">
                <h5>Thông tin cơ bản</h5>
            </div>
            <div class="detail-body">
                <div class="detail-row">
                    <div class="detail-label">ID</div>
                    <div class="detail-value">@Model.Id</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Tên</div>
                    <div class="detail-value">@Model.Name</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">SĐT</div>
                    <div class="detail-value">@Model.Phone</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Địa chỉ</div>
                    <div class="detail-value">@Model.Address</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="row g-3">
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-card-label">Số phiếu nhập</div>
                    <div class="stat-card-value">@ViewBag.PurchaseCount</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-card-label">Tổng nhập</div>
                    <div class="stat-card-value">@string.Format("{0:N0}", ViewBag.TotalPurchase) đ</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-card-label">Nhập gần nhất</div>
                    <div class="fs-5 fw-bold">@(ViewBag.LastPurchase?.ToString("dd/MM/yyyy") ?? "Chưa nhập")</div>
                </div>
            </div>
        </div>

        @if (ViewBag.RecentPurchases != null && ((IEnumerable<QuanLyBanHang.Models.PurchaseInvoice>)ViewBag.RecentPurchases).Any())
        {
            <div class="card-modern mt-3">
                <div class="card-head">
                    <h5><i class="bi bi-cart-plus me-2"></i>Phiếu nhập gần đây</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Mã</th>
                                    <th>Ngày</th>
                                    <th class="text-end">Tổng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in (IEnumerable<QuanLyBanHang.Models.PurchaseInvoice>)ViewBag.RecentPurchases)
                                {
                                    <tr>
                                        <td class="fw-semibold">#@p.Id</td>
                                        <td>@p.CreatedAt.ToString("dd/MM HH:mm")</td>
                                        <td class="text-end fw-semibold">@string.Format("{0:N0}", p.Total) đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
