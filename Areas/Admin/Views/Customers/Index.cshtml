@model IEnumerable<QuanLyBanHang.Areas.Admin.Controllers.CustomersController.CustomerViewModel>
@using QuanLyBanHang.Helpers

@{
    ViewData["Title"] = "Khách hàng";
    var pagination = ViewBag.Pagination as QuanLyBanHang.ViewModels.PaginationModel;
    var count = Model.Count();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-customers.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-people"></i> Khách hàng</h3>
        <p>Quản lý thông tin khách hàng</p>
    </div>
    <div class="page-actions">
    </div>
</div>

<form method="get" class="filters-bar">
    <div class="form-group">
        <label class="form-label">Tìm kiếm</label>
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo tên, SĐT..." value="@Context.Request.Query["search"]" style="width:200px">
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-search"></i> Lọc</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i> Xóa lọc</a>
    </div>
</form>

<div class="card-modern">
    <div class="card-head">
        <h5>Danh sách khách hàng</h5>
        <span class="badge bg-primary">@(pagination?.TotalItems ?? 0)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0 customer-table">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Địa chỉ</th>
                        <th class="text-center">Số đơn</th>
                        <th class="text-end">Đã chi</th>
                        <th>Mua gần nhất</th>
                        <th class="text-end" style="width:280px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model) {
                        <tr>
                            <td>
                                <div class="customer-cell">
                                    @if (!string.IsNullOrWhiteSpace(item.AvatarPath))
                                    {
                                        <img src="@item.AvatarPath" alt="" class="avatar-sm" />
                                    }
                                    else
                                    {
                                        <div class="customer-avatar">@item.Name.Substring(0, 1).ToUpper()</div>
                                    }
                                    <div class="customer-info">
                                        <h6>@item.Name</h6>
                                        <small>@(!string.IsNullOrWhiteSpace(item.Email) ? item.Email : $"ID: {item.Id}")</small>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Phone</td>
                            <td>@item.Address</td>
                            <td class="text-center">
                                <span class="badge order-badge @(item.OrderCount > 0 ? "bg-info" : "bg-secondary")">@item.OrderCount</span>
                            </td>
                            <td class="text-end"><span class="spent-amount">@string.Format("{0:N0}", item.TotalSpent) đ</span></td>
                            <td><span class="last-date">@(item.LastOrderDate?.ToString("dd/MM/yyyy") ?? "-")</span></td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Xem"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="Sửa"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (pagination != null && pagination.TotalPages > 1)
    {
        <div class="card-head" style="border-top:1px solid var(--border);border-bottom:none">
            <small class="text-muted">Hiển thị @count trên tổng số @pagination.TotalItems mục</small>
            <partial name="_Pagination" model="pagination" />
        </div>
    }
</div>
