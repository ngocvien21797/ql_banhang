@model QuanLyBanHang.Models.Customer
@using QuanLyBanHang.Helpers

@{ ViewData["Title"] = "Chi tiết khách hàng"; }

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-customers.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h3><i class="bi bi-info-circle"></i> @ViewData["Title"]</h3>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="customer-detail row g-4">
    <div class="col-lg-4">
        <div class="profile-card">
            <div class="profile-cover"></div>
            @if (!string.IsNullOrWhiteSpace(Model.AvatarPath))
            {
                <img src="@Model.AvatarPath" alt="" class="profile-avatar-img" />
            }
            else
            {
                <div class="profile-avatar">@Model.Name.Substring(0, 1).ToUpper()</div>
            }
            <div class="profile-body">
                <h3 class="profile-name">@Model.Name</h3>
                <p class="profile-phone"><i class="bi bi-telephone-fill"></i> @Model.Phone</p>

                <div class="info-row">
                    <span class="info-label"><i class="bi bi-envelope me-1"></i> Email</span>
                    <span class="info-value">@(!string.IsNullOrWhiteSpace(Model.Email) ? Model.Email : "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-calendar me-1"></i> Ngày sinh</span>
                    <span class="info-value">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-gender-ambiguous me-1"></i> Giới tính</span>
                    <span class="info-value">@(!string.IsNullOrWhiteSpace(Model.Gender) ? Model.Gender : "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-geo-alt me-1"></i> Địa chỉ</span>
                    <span class="info-value">@(!string.IsNullOrWhiteSpace(Model.Address) ? Model.Address : "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-wallet2 me-1"></i> Số dư ví</span>
                    <span class="info-value">@string.Format("{0:N0}", Model.WalletBalance) đ</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="bi bi-hash me-1"></i> Mã KH</span>
                    <span class="info-value">#@Model.Id</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="stat-grid">
            <div class="stat-box">
                <div class="stat-icon orders"><i class="bi bi-receipt"></i></div>
                <div class="stat-num">@ViewBag.OrderCount</div>
                <div class="stat-label">Số đơn hàng</div>
            </div>
            <div class="stat-box">
                <div class="stat-icon spent"><i class="bi bi-coin"></i></div>
                <div class="stat-num">@string.Format("{0:N0}", ViewBag.TotalSpent) đ</div>
                <div class="stat-label">Tổng đã chi</div>
            </div>
            <div class="stat-box">
                <div class="stat-icon last"><i class="bi bi-calendar-check"></i></div>
                <div class="stat-num">@(ViewBag.LastOrder?.ToString("dd/MM/yyyy") ?? "—")</div>
                <div class="stat-label">Mua gần nhất</div>
            </div>
        </div>

        @if (ViewBag.RecentOrders != null && ((IEnumerable<QuanLyBanHang.Models.SalesInvoice>)ViewBag.RecentOrders).Any())
        {
            <div class="card-modern mt-3">
                <div class="card-head">
                    <h5><i class="bi bi-receipt me-2"></i>Đơn hàng gần đây</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Mã</th>
                                    <th>Ngày</th>
                                    <th>TT</th>
                                    <th class="text-end">Tổng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in (IEnumerable<QuanLyBanHang.Models.SalesInvoice>)ViewBag.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-semibold">@(!string.IsNullOrWhiteSpace(o.Code) ? o.Code : $"#{o.Id}")</td>
                                        <td>@o.CreatedAt.ToString("dd/MM HH:mm")</td>
                                        <td><span class="status-badge @(o.Status=="Completed"?"success":o.Status=="Cancelled"?"danger":"warning")">@SalesInvoice.DisplayStatus(o.Status)</span></td>
                                        <td class="text-end fw-semibold">@string.Format("{0:N0}", o.Total) đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
