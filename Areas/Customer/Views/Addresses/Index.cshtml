@model IEnumerable<QuanLyBanHang.Models.CustomerAddress>
@{
    ViewData["Title"] = "Sổ địa chỉ";
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success" style="border-radius:10px;">@TempData["Ok"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-bookmark me-2 text-danger"></i>Sổ địa chỉ</h4>
        <p class="text-muted small mb-0">Quản lý địa chỉ giao hàng của bạn</p>
    </div>
    <a class="btn btn-danger sf-pill" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm địa chỉ</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-geo-alt" style="font-size:48px;"></i>
        <p class="mt-2">Bạn chưa có địa chỉ nào.</p>
        <a class="btn btn-danger sf-pill" asp-action="Create">Thêm địa chỉ mới</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var a in Model)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="fw-bold">@a.ReceiverName</span>
                                @if (a.IsDefault)
                                {
                                    <span class="badge bg-danger ms-2" style="font-weight:600;">Mặc định</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(a.Label))
                                {
                                    <span class="badge bg-light text-dark ms-1">@a.Label</span>
                                }
                            </div>
                        </div>
                        <div class="small text-muted mb-1">@a.Phone</div>
                        <div class="small text-muted">
                            @a.Address@(!string.IsNullOrWhiteSpace(a.Ward)?", "+a.Ward:"")@(!string.IsNullOrWhiteSpace(a.District)?", "+a.District:"")@(!string.IsNullOrWhiteSpace(a.Province)?", "+a.Province:"")
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <a class="btn btn-sm btn-outline-danger" asp-action="Edit" asp-route-id="@a.Id">
                                <i class="bi bi-pencil me-1"></i>Sửa
                            </a>
                            @if (!a.IsDefault)
                            {
                                <button class="btn btn-sm btn-outline-secondary" onclick="setDefault(@a.Id)">
                                    <i class="bi bi-check-circle me-1"></i>Đặt mặc định
                                </button>
                            }
                            <form method="post" asp-action="Delete" asp-route-id="@a.Id"
                                  onsubmit="return confirm('Xóa địa chỉ này?')" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        async function setDefault(id) {
            try {
                const res = await fetch('@Url.Action("SetDefault")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ id })
                });
                const data = await res.json();
                if (data.success) location.reload();
            } catch (e) { console.error(e); }
        }
    </script>
}
