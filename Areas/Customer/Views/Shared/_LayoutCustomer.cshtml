@using System.Security.Claims
@using QuanLyBanHang.Helpers
@using QuanLyBanHang.ViewModels
@using QuanLyBanHang.Data
@inject SalesDbContext _db
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;

    var isCustomer = role == "2";
    var isAdmin = role == "1";

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var cart = Context.Session.GetObject<List<CartItemVM>>("CART") ?? new List<CartItemVM>();
    var cartCount = cart.Sum(x => x.Quantity);

    var q = Context.Request.Query["q"].ToString();

    var uid = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    long.TryParse(uid, out var userId);
    var customerInfo = isCustomer && userId > 0
        ? _db.Users.Where(u => u.Id == userId).Select(u => new {
            Name = u.Customer != null ? u.Customer.Name : u.Username,
            Avatar = u.Customer != null ? u.Customer.AvatarPath : null
        }).FirstOrDefault()
        : null;
    var displayName = customerInfo?.Name ?? (string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Tài khoản" : User.Identity!.Name);
    var avatarPath = customerInfo?.Avatar;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMart - Mua Sắm Online</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/chatbot.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

<body class="storefront">
<header class="sf-topbar sticky-top">
    <div class="container">
        <div class="d-flex align-items-center gap-2">
            <!-- Mobile menu -->
            <button class="btn btn-link text-white fs-5 p-1 d-lg-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#sfMenu"
                    aria-controls="sfMenu"
                    aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>

            <!-- Brand -->
            <a class="sf-brand"
               asp-area="Customer" asp-controller="Shop" asp-action="Index">
                <span class="sf-brand-badge"><i class="bi bi-bag-check-fill"></i></span>
                <span class="sf-brand-text">MiniMart</span>
            </a>

            <!-- Search desktop -->
            <form class="sf-search d-none d-md-flex"
                  method="get"
                  asp-area="Customer" asp-controller="Shop" asp-action="Index">
                <div class="input-group">
                    <input class="form-control" name="q" value="@q" placeholder="Bạn tìm gì hôm nay?" />
                    <button class="btn" type="submit"><i class="bi bi-search me-1"></i>Tìm</button>
                </div>
            </form>

            <div class="sf-topbar-right">
                <!-- Notifications -->
                @if (isAuth && isCustomer)
                {
                    <a class="sf-topbar-link position-relative"
                       asp-area="Customer" asp-controller="Notification" asp-action="Index"
                       title="Thông báo"
                       id="notificationBell">
                        <i class="bi bi-bell"></i>
                         <span class="d-none d-md-inline">Thông báo</span>
                        <span class="sf-badge-count" id="notifCount" style="display:none;">0</span>
                    </a>
                }

                <!-- Wishlist -->
                @if (isAuth && isCustomer)
                {
                    <a class="sf-topbar-link"
                       asp-area="Customer" asp-controller="Wishlist" asp-action="Index"
                       title="Yêu thích">
                        <i class="bi bi-heart"></i>
                         <span class="d-none d-md-inline">Yêu thích</span>
                    </a>
                }

                <!-- Cart -->
                <a class="sf-topbar-link"
                   asp-area="Customer" asp-controller="Cart" asp-action="Index"
                   title="Giỏ hàng">
                    <i class="bi bi-cart3"></i>
                    <span class="d-none d-md-inline">Giỏ hàng</span>
                    @if (cartCount > 0)
                    {
                        <span class="sf-badge-count">@cartCount</span>
                    }
                </a>

                <!-- Auth -->
                @if (isAuth)
                {
                    @if (isCustomer)
                    {
                        <div class="dropdown">
                            <button class="sf-topbar-link dropdown-toggle border-0 bg-transparent"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                @if (!string.IsNullOrWhiteSpace(avatarPath))
                                {
                                    <img src="@avatarPath" alt="Avatar" class="rounded-circle" style="width:26px;height:26px;object-fit:cover;border:2px solid rgba(255,255,255,.6);" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                <span class="d-none d-md-inline">@displayName</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end sf-dropdown">
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer" asp-controller="Shop" asp-action="MyOrders">
                                        <i class="bi bi-receipt"></i>Đơn hàng
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer" asp-controller="Wishlist" asp-action="Index">
                                        <i class="bi bi-heart"></i>Yêu thích
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer" asp-controller="Notification" asp-action="Index">
                                        <i class="bi bi-bell"></i>Thông báo
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer" asp-controller="Profile" asp-action="Index">
                                        <i class="bi bi-person-gear"></i>Tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer" asp-controller="News" asp-action="Index">
                                        <i class="bi bi-newspaper"></i>Tin tức
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer" asp-controller="Addresses" asp-action="Index">
                                        <i class="bi bi-bookmark"></i>Sổ địa chỉ
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else if (isAdmin)
                    {
                        <div class="dropdown">
                            <button class="sf-topbar-link dropdown-toggle border-0 bg-transparent"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-shield-lock"></i>
                                <span class="d-none d-md-inline">@displayName</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end sf-dropdown">
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Admin" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i>Vào Admin
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area="" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                }
                else
                {
                    <a class="sf-topbar-link"
                       asp-area="" asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@returnUrl">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span class="d-none d-md-inline">Đăng nhập</span>
                    </a>

                    <a class="btn btn-light sf-pill px-3 py-1 text-dark fw-semibold"
                       asp-area="" asp-controller="Account" asp-action="Register"
                       asp-route-returnUrl="@returnUrl">
                        Đăng ký
                    </a>
                }
            </div>
        </div>

        <!-- Search mobile -->
        <div class="mt-2 d-md-none">
            <form method="get" asp-area="Customer" asp-controller="Shop" asp-action="Index">
                <div class="sf-search w-100">
                    <div class="input-group">
                        <input class="form-control" name="q" value="@q" placeholder="Bạn tìm gì hôm nay?" />
                        <button class="btn" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</header>



<!-- Offcanvas menu -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="sfMenu" aria-labelledby="sfMenuLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold text-danger" id="sfMenuLabel">
            <span class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;">
                <i class="bi bi-bag-check-fill"></i>
            </span>
            MiniMart
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
    </div>

    <div class="offcanvas-body p-0">
        <div class="list-group list-group-flush sf-menu">
            <a class="list-group-item list-group-item-action border-0 py-3"
               asp-area="Customer" asp-controller="Shop" asp-action="Index">
                <i class="bi bi-grid me-3 text-danger"></i>Sản phẩm
            </a>

            <a class="list-group-item list-group-item-action border-0 py-3"
               asp-area="Customer" asp-controller="Cart" asp-action="Index">
                <i class="bi bi-cart3 me-3 text-danger"></i>Giỏ hàng
            </a>

            <a class="list-group-item list-group-item-action border-0 py-3"
               asp-area="Customer" asp-controller="News" asp-action="Index">
                <i class="bi bi-newspaper me-3 text-danger"></i>Tin tức
            </a>

            @if (isAuth && isCustomer)
            {
                <a class="list-group-item list-group-item-action border-0 py-3"
                   asp-area="Customer" asp-controller="Wishlist" asp-action="Index">
                    <i class="bi bi-heart me-3 text-danger"></i>Yêu thích
                </a>

                <a class="list-group-item list-group-item-action border-0 py-3"
                   asp-area="Customer" asp-controller="Notification" asp-action="Index">
                    <i class="bi bi-bell me-3 text-danger"></i>Thông báo
                </a>

                <a class="list-group-item list-group-item-action border-0 py-3"
                   asp-area="Customer" asp-controller="Shop" asp-action="MyOrders">
                    <i class="bi bi-receipt me-3 text-danger"></i>Đơn hàng
                </a>

                <a class="list-group-item list-group-item-action border-0 py-3"
                   asp-area="Customer" asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person-lines-fill me-3 text-danger"></i>Tài khoản
                </a>

                <a class="list-group-item list-group-item-action border-0 py-3"
                   asp-area="Customer" asp-controller="Addresses" asp-action="Index">
                    <i class="bi bi-bookmark me-3 text-danger"></i>Sổ địa chỉ
                </a>
            }

            @if (isAdmin)
            {
                <a class="list-group-item list-group-item-action border-0 py-3"
                   asp-area="Admin" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-shield-lock me-3 text-danger"></i>Admin
                </a>
            }
        </div>

        <div class="p-3 border-top mt-2">
            <div class="d-flex align-items-start gap-3 mb-3">
                <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                    <i class="bi bi-truck text-danger"></i>
                </div>
                <div>
                    <div class="fw-semibold small">Giao hàng nhanh</div>
                    <div class="small text-muted">trải nghiệm mua sắm</div>
                </div>
            </div>

            <div class="d-flex align-items-start gap-3">
                <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                    <i class="bi bi-shield-check text-danger"></i>
                </div>
                <div>
                    <div class="fw-semibold small">Thanh toán an toàn</div>
                </div>
            </div>
        </div>
    </div>
</div>

<main class="container sf-main py-4">
    @if (TempData["Ok"] is string okMsg)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@okMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string errMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>

