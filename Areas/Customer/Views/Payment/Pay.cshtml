@model QuanLyBanHang.Models.SalesInvoice
@{
    ViewData["Title"] = "Thanh toán";
    var isBank = Model.PaymentMethod == "BANK";
    var isWallet = Model.PaymentMethod == "WALLET";
}
@section Styles{
    <link rel="stylesheet" href="~/css/customer/Checkout.css" />
}

<div class="checkout-page">
    <div class="container" style="max-width:860px;">

        <div class="checkout-header">
            <h2>Thanh toán đơn hàng</h2>
            <p>Mã đơn: <strong style="color:var(--co-red)">@Model.Code</strong></p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="checkout-alert alert alert-danger d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            </div>
        }
        @if (TempData["Ok"] != null)
        {
            <div class="checkout-alert alert alert-success d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill"></i> @TempData["Ok"]
            </div>
        }

        <div class="row g-4">

            <!-- LEFT: Bill + Bank/Wallet Info -->
            <div class="col-lg-7">

                <!-- BILL -->
                <div class="checkout-card mb-3">
                    <div class="section-title" style="margin-bottom:16px;padding-bottom:12px;">
                        <i class="bi bi-receipt"></i>
                        Hóa đơn chi tiết
                        <span class="badge-status ms-auto @(isBank ? "badge-info" : "badge-warning")">
                            @(isBank ? "Chuyển khoản" : "Ví điện tử")
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.Items)
                                {
                                    <tr>
                                        <td><span class="fw-semibold">@(i.Product?.Name ?? $"#{i.ProductId}")</span></td>
                                        <td class="text-center">@i.Quantity</td>
                                        <td class="text-end">@string.Format("{0:N0}₫", i.UnitPrice)</td>
                                        <td class="text-end fw-semibold">@string.Format("{0:N0}₫", i.LineTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <hr class="checkout-divider" />
                    <div class="summary-row">
                        <span>Tạm tính</span>
                        <strong>@string.Format("{0:N0}₫", Model.Items.Sum(i => i.LineTotal))</strong>
                    </div>
                    <div class="summary-row">
                        <span>Phí vận chuyển</span>
                        <strong>@string.Format("{0:N0}₫", Model.ShippingFee)</strong>
                    </div>
                    @if (Model.Discount > 0)
                    {
                        <div class="summary-row">
                            <span>Giảm giá</span>
                            <strong class="text-success">-@string.Format("{0:N0}₫", Model.Discount)</strong>
                        </div>
                    }
                    <hr class="checkout-divider" />
                    <div class="summary-total" style="margin-top:10px;padding-top:10px;">
                        <span>Tổng cộng</span>
                        <strong>@string.Format("{0:N0}₫", Model.Total)</strong>
                    </div>
                </div>

                <!-- BANK INFO -->
                @if (isBank)
                {
                    <div class="checkout-card mb-3">
                        <div class="section-title" style="margin-bottom:14px;padding-bottom:10px;font-size:15px;">
                            <i class="bi bi-bank"></i> Thông tin chuyển khoản
                        </div>
                        <div class="pay-bill-info">
                            <span class="label">Ngân hàng</span>
                            <span class="value">NCB (Ngân hàng Quốc Dân)</span>
                            <span class="label">Số tài khoản</span>
                            <span class="value" style="font-size:16px;">123456789</span>
                            <span class="label">Chủ tài khoản</span>
                            <span class="value">NGUYEN VAN A</span>
                            <span class="label">Số tiền</span>
                            <span class="value" style="color:var(--co-red);">@string.Format("{0:N0}₫", Model.Total)</span>
                            <span class="label">Nội dung</span>
                            <span class="value">TT @Model.Code</span>
                        </div>
                    </div>
                }

                <!-- WALLET INFO -->
                @if (isWallet)
                {
                    <div class="checkout-card mb-3">
                        <div class="section-title" style="margin-bottom:14px;padding-bottom:10px;font-size:15px;">
                            <i class="bi bi-wallet2"></i> Ví điện tử
                        </div>
                        <div class="pay-bill-info">
                            <span class="label">Số dư ví</span>
                            <span class="value">@string.Format("{0:N0}₫", Model.Customer?.WalletBalance ?? 0)</span>
                            <span class="label">Số tiền thanh toán</span>
                            <span class="value" style="color:var(--co-red);">-@string.Format("{0:N0}₫", Model.Total)</span>
                            <span class="label">Trạng thái</span>
                            <span class="value">
                                @if ((Model.Customer?.WalletBalance ?? 0) < Model.Total)
                                {
                                    <span class="badge-status badge-danger"><i class="bi bi-x-circle me-1"></i>Số dư không đủ</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-success"><i class="bi bi-check-circle me-1"></i>Số dư khả dụng</span>
                                }
                            </span>
                        </div>
                    </div>
                }

                <!-- Back button left side -->
                <a class="checkout-back-btn" asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id">
                    <i class="bi bi-arrow-left"></i> Quay lại chi tiết đơn
                </a>

            </div>

            <!-- RIGHT: QR + Confirm -->
            <div class="col-lg-5">
                <div class="checkout-summary text-center">

                    @if (isBank)
                    {
                        <div class="qr-box">
                            <img src="@ViewBag.QR" alt="QR thanh toán"
                                 onerror="this.parentElement.innerHTML='<div class=\\'text-muted small py-4\\'><i class=\\'bi bi-qr-code-scan\\' style=\\'font-size:48px;\\'></i><br>QR Code</div>'" />
                            <div class="small text-muted mt-2">Quét mã QR để thanh toán</div>
                        </div>

                        <div class="qr-amount-box">
                            <div class="amount-label">Số tiền</div>
                            <div class="amount-value">@string.Format("{0:N0}₫", Model.Total)</div>
                        </div>

                        <form method="post" asp-action="Confirm">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="checkout-submit-btn" type="submit">
                                <i class="bi bi-check2-circle"></i> Xác nhận đã chuyển khoản
                            </button>
                        </form>
                        <div class="checkout-note">
                            <i class="bi bi-info-circle me-1"></i>Demo — nhấn nút để mô phỏng thanh toán
                        </div>
                    }

                    @if (isWallet)
                    {
                        <div class="mb-3">
                            <div class="wallet-icon-box">
                                <i class="bi bi-wallet2"></i>
                            </div>
                        </div>

                        <div class="qr-amount-box">
                            <div class="amount-label">Số tiền thanh toán</div>
                            <div class="amount-value">@string.Format("{0:N0}₫", Model.Total)</div>
                        </div>

                        <form method="post" asp-action="Confirm">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="checkout-submit-btn" type="submit"
                                    @((Model.Customer?.WalletBalance ?? 0) < Model.Total ? "disabled" : "")>
                                <i class="bi bi-check2-circle"></i> Thanh toán
                            </button>
                        </form>
                        @if ((Model.Customer?.WalletBalance ?? 0) >= Model.Total)
                        {
                            <div class="checkout-note">
                                <i class="bi bi-info-circle me-1"></i>Số dư sẽ được trừ sau khi xác nhận
                            </div>
                        }
                        else
                        {
                            <div class="checkout-note" style="color:#dc2626;">
                                <i class="bi bi-exclamation-circle me-1"></i>Vui lòng nạp thêm tiền vào ví
                            </div>
                        }
                    }

                </div>
            </div>

        </div>

    </div>
</div>
