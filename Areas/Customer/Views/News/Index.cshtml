@model List<QuanLyBanHang.Models.Article>
@{
    ViewData["Title"] = "Tin tức";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/customer/news.css" asp-append-version="true" />
}

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h3 class="mb-1">Tin tức</h3>
        <div class="text-muted">Có <b>@total</b> bài viết</div>
    </div>
    <a asp-area="Customer" asp-controller="Shop" asp-action="Index" class="btn-back-shop">
        <i class="bi bi-arrow-left me-1"></i>Quay lại cửa hàng
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-newspaper" style="font-size:3rem;color:#ddd;"></i>
        <p class="text-muted mt-3">Chưa có bài viết nào.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var a in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm news-card">
                    <a asp-action="Detail" asp-route-id="@a.Id" asp-route-slug="@a.Slug">
                        @if (!string.IsNullOrWhiteSpace(a.ImagePath))
                        {
                            <img src="@a.ImagePath" alt="@a.Title" class="card-img-top" />
                        }
                        else
                        {
                            <div class="card-img-top news-thumb-placeholder">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </a>
                    <div class="card-body d-flex flex-column p-3">
                        <a asp-action="Detail" asp-route-id="@a.Id" asp-route-slug="@a.Slug"
                           class="fw-bold text-dark text-decoration-none mb-2" style="font-size:15px;line-height:1.3;">
                            @a.Title
                        </a>
                        @if (!string.IsNullOrWhiteSpace(a.Summary))
                        {
                            <p class="small text-muted mb-3 flex-grow-1">@a.Summary</p>
                        }
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@a.CreatedAt.ToString("dd/MM/yyyy")</small>
                            <a asp-action="Detail" asp-route-id="@a.Id" asp-route-slug="@a.Slug" class="btn btn-sm btn-outline-danger sf-pill">
                                Đọc tiếp <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
