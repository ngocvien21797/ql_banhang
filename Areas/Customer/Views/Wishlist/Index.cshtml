@model List<QuanLyBanHang.Models.Wishlist>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h3 class="mb-1"><i class="bi bi-heart-fill text-danger me-2"></i>Sản phẩm yêu thích</h3>
        <div class="sf-muted">Có <b>@Model.Count</b> sản phẩm yêu thích</div>
    </div>
    <a class="btn btn-outline-danger sf-pill" asp-controller="Shop" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Tiếp tục mua sắm
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-heart" style="font-size:64px;color:#ddd;"></i>
        <h5 class="mt-3 text-muted">Chưa có sản phẩm yêu thích nào</h5>
        <p class="text-muted">Hãy khám phá cửa hàng và thêm sản phẩm bạn yêu thích!</p>
        <a class="btn btn-danger sf-pill mt-2" asp-controller="Shop" asp-action="Index">Khám phá ngay</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card product-card h-100">
                    <div class="position-relative">
                        <div class="sf-img" style="height:220px;">
                            @if (!string.IsNullOrWhiteSpace(item.Product?.ImagePath))
                            {
                                <img src="@item.Product.ImagePath" alt="@item.Product.Name" />
                            }
                            else
                            {
                                <i class="bi bi-phone"></i>
                            }
                        </div>
                        @if (item.Product != null && item.Product.Stock > 0)
                        {
                            <span class="badge bg-success position-absolute top-0 end-0 m-2">Còn @item.Product.Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary position-absolute top-0 end-0 m-2">Hết hàng</span>
                        }
                        <form method="post" asp-action="Remove" asp-route-productId="@item.ProductId" class="position-absolute top-0 start-0 m-2">
                            <button type="submit" class="btn btn-sm btn-light rounded-circle" title="Bỏ yêu thích" style="width:32px;height:32px;">
                                <i class="bi bi-heart-fill text-danger"></i>
                            </button>
                        </form>
                    </div>

                    <div class="card-body d-flex flex-column p-3">
                        <a asp-controller="Shop" asp-action="Product" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none mb-1" style="font-size:15px;line-height:1.3;">
                            @item.Product?.Name
                        </a>
                        <div class="small sf-muted mb-2">@item.Product?.Sku</div>

                        <div class="product-price mb-3">@string.Format("{0:N0}", item.Product?.Price) đ</div>

                        <div class="mt-auto d-flex flex-column gap-2">
                            <form method="post" asp-controller="Cart" asp-action="Add" class="w-100">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="qty" value="1" />
                                <button class="btn btn-danger w-100 sf-pill @(item.Product != null && item.Product.Stock <= 0 ? "disabled" : "")" type="submit">
                                    <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                                </button>
                            </form>
                            <form method="post" asp-controller="Cart" asp-action="BuyNow" class="w-100">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="qty" value="1" />
                                <button class="btn btn-warning w-100 sf-pill @(item.Product != null && item.Product.Stock <= 0 ? "disabled" : "")" type="submit">
                                    <i class="bi bi-lightning-charge me-1"></i>Mua ngay
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
