@model List<QuanLyBanHang.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
    var unreadCount = Model.Count(x => !x.IsRead);
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h3 class="mb-1"><i class="bi bi-bell-fill text-danger me-2"></i>Thông báo</h3>
        <div class="sf-muted">@Model.Count thông báo (@unreadCount chưa đọc)</div>
    </div>
    @if (unreadCount > 0)
    {
        <form method="post" asp-action="MarkAllRead">
            <button class="btn btn-outline-danger sf-pill" type="submit">
                <i class="bi bi-check-all me-1"></i>Đánh dấu tất cả đã đọc
            </button>
        </form>
    }
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-bell" style="font-size:64px;color:#ddd;"></i>
        <h5 class="mt-3 text-muted">Chưa có thông báo nào</h5>
        <p class="text-muted">Bạn sẽ nhận được thông báo về đơn hàng tại đây.</p>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action border-0 mb-2 rounded-3 shadow-sm @(item.IsRead ? "" : "border-start border-danger border-4")" style="background:#fff;">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <strong>@item.Title</strong>
                            @if (!item.IsRead)
                            {
                                <span class="badge bg-danger" style="font-size:10px;">Mới</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Message))
                        {
                            <p class="mb-1 text-muted small">@item.Message</p>
                        }
                        <small class="text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="d-flex gap-2 ms-3 flex-shrink-0">
                        @if (!item.IsRead)
                        {
                            <form method="post" asp-action="MarkRead" asp-route-id="@item.Id">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill" type="submit" title="Đánh dấu đã đọc">
                                    <i class="bi bi-check"></i>
                                </button>
                            </form>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Url))
                        {
                            <a class="btn btn-sm btn-outline-danger rounded-pill" href="@item.Url" title="Xem chi tiết">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
