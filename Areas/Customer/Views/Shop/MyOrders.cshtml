@model List<QuanLyBanHang.Models.SalesInvoice>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <h4 class="mb-1 fw-bold"><i class="bi bi-receipt text-danger me-2"></i>Đơn hàng của tôi</h4>
        <div class="text-muted small">Tổng số: <b>@Model.Count</b> đơn hàng</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-danger sf-pill btn-sm" asp-action="Index"><i class="bi bi-grid me-1"></i>Sản phẩm</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body text-center py-5">
            <i class="bi bi-receipt" style="font-size:60px;color:#dee2e6;"></i>
            <h5 class="text-muted mt-3">Chưa có đơn hàng nào</h5>
            <p class="text-muted">Hãy chọn sản phẩm và đặt hàng ngay!</p>
            <a class="btn btn-danger sf-pill mt-2" asp-action="Index"><i class="bi bi-cart-plus me-1"></i>Mua sắm ngay</a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var x in Model)
        {
            var statusColor = x.Status switch { "Completed" => "success", "Cancelled" => "danger", "Shipped" => "primary", "Confirmed" => "info", _ => "secondary" };
            var payColor = x.PaymentStatus == "Paid" ? "success" : x.PaymentStatus == "Pending" ? "warning" : "secondary";

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-bold text-danger fs-5">@(!string.IsNullOrWhiteSpace(x.Code) ? x.Code : $"#{x.Id}")</span>
                                <span class="badge bg-@statusColor rounded-pill">@SalesInvoice.DisplayStatus(x.Status)</span>
                                <span class="badge bg-@payColor rounded-pill">@SalesInvoice.DisplayPaymentMethod(x.PaymentMethod) - @SalesInvoice.DisplayPaymentStatus(x.PaymentStatus)</span>
                            </div>
                            <div class="text-muted small">@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-danger fs-5">@string.Format("{0:N0}", x.Total) đ</div>
                            <div class="d-flex gap-2 mt-2 flex-wrap justify-content-end">
                                <a class="btn btn-outline-danger sf-pill btn-sm" asp-action="Details" asp-route-id="@x.Id">
                                    <i class="bi bi-eye me-1"></i>Chi tiết
                                </a>
                                @if ((x.PaymentMethod == "BANK" || x.PaymentMethod == "WALLET") && x.PaymentStatus != "Paid")
                                {
                                    <a class="btn btn-danger sf-pill btn-sm" asp-controller="Payment" asp-action="Pay" asp-route-id="@x.Id">
                                        <i class="bi bi-credit-card me-1"></i>Thanh toán
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="mt-2 d-flex flex-wrap gap-3 small text-muted">
                        <span><i class="bi bi-person me-1"></i>@x.ReceiverName</span>
                        <span><i class="bi bi-truck me-1"></i>@SalesInvoice.DisplayPaymentMethod(x.PaymentMethod)</span>
                        @if (x.Items.Count > 0)
                        {
                            <span><i class="bi bi-box me-1"></i>@x.Items.Count sản phẩm</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
