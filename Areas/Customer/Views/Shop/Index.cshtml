@model List<QuanLyBanHang.Models.Product>
@using QuanLyBanHang.Models
@{
    ViewData["Title"] = "Cửa hàng";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    long? selectedCategory = ViewBag.CategoryId as long?;
    string q = ViewBag.Query as string ?? "";
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    string sort = ViewBag.Sort as string ?? "name";

    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;

    var avgRatings = ViewBag.AvgRatings as Dictionary<long, (double Avg, int Count)> ?? new Dictionary<long, (double Avg, int Count)>();
    var wishlistIds = ViewBag.WishlistIds as HashSet<long> ?? new HashSet<long>();

    var isAuth = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/shop-filter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/promotions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/banner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/news.css" asp-append-version="true" />
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h3 class="mb-1">Cửa hàng</h3>
        <div class="sf-muted">Đang có <b>@total</b> sản phẩm</div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a class="btn btn-sm btn-outline-danger sf-pill" asp-controller="Cart" asp-action="Index">
            <i class="bi bi-cart3 me-1"></i>Giỏ hàng
        </a>
        @if (isAuth)
        {
            <a class="btn btn-sm btn-outline-danger sf-pill" asp-controller="Wishlist" asp-action="Index">
                <i class="bi bi-heart me-1"></i>Yêu thích
            </a>
            <a class="btn btn-sm btn-outline-danger sf-pill" asp-controller="Shop" asp-action="MyOrders">
                <i class="bi bi-receipt me-1"></i>Đơn của tôi
            </a>
        }
    </div>
</div>

@{
    var banners = ViewBag.Banners as List<Banner> ?? new List<Banner>();
    var recentArticles = ViewBag.RecentArticles as List<Article> ?? new List<Article>();
}

@if (banners.Count > 0)
{
    <div id="bannerCarousel" class="carousel slide mb-4">
        <div class="carousel-indicators">
            @for (int i = 0; i < banners.Count; i++)
            {
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : null)"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < banners.Count; i++)
            {
                var b = banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@b.ImagePath" class="d-block w-100" alt="@b.Title" />
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
}

<form method="get" class="sf-filter-wrap">
    <div class="row">
        <div class="col-12 col-sm sf-filter-col-search">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" name="q" value="@q" placeholder="Tìm sản phẩm..." />
            </div>
        </div>
        <div class="col-6 col-sm sf-filter-col-cat">
            <select class="form-select" name="categoryId">
                <option value="">Tất cả danh mục</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id" selected="@(selectedCategory == c.Id ? "selected" : null)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm sf-filter-col-sort">
            <select class="form-select" name="sort">
                <option value="price_asc" selected="@(sort=="price_asc"?"selected":null)">Giá tăng dần</option>
                <option value="price_desc" selected="@(sort=="price_desc"?"selected":null)">Giá giảm dần</option>
                <option value="newest" selected="@(sort=="newest"?"selected":null)">Mới nhất</option>
            </select>
        </div>
        <div class="col-6 sf-filter-col-price">
            <input class="form-control" name="minPrice" value="@minPrice" placeholder="Giá từ" type="number" />
        </div>
        <div class="col-6 sf-filter-col-price">
            <input class="form-control" name="maxPrice" value="@maxPrice" placeholder="Giá đến" type="number" />
        </div>
        <div class="col-12 col-sm-auto sf-filter-col-actions">
            <div class="d-flex gap-2">
                <button class="btn-filter btn-danger" type="submit"><i class="bi bi-funnel"></i>Lọc</button>
                <a class="btn-filter btn-outline" asp-action="Index"><i class="bi bi-x-lg"></i>Xoá</a>
            </div>
        </div>
    </div>
</form>

@if (categories.Count > 0)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-sm btn-outline-danger sf-pill @(selectedCategory==null ? "active": "")" asp-action="Index"
           asp-route-q="@q" asp-route-sort="@sort" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice">Tất cả</a>
        @foreach (var c in categories)
        {
            <a class="btn btn-sm btn-outline-danger sf-pill @(selectedCategory==c.Id ? "active": "")"
               asp-action="Index" asp-route-categoryId="@c.Id" asp-route-q="@q" asp-route-sort="@sort"
               asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice">@c.Name</a>
        }
    </div>
}

<div class="row g-3">
@foreach (var p in Model)
{
    double avg = 0;
    int reviewCount = 0;
    if (avgRatings.TryGetValue(p.Id, out var ratingInfo))
    {
        avg = ratingInfo.Avg;
        reviewCount = ratingInfo.Count;
    }
    var isLiked = wishlistIds.Contains(p.Id);

    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <div class="card product-card h-100">
            <div class="position-relative">
                <a asp-action="Product" asp-route-id="@p.Id">
                    <div class="sf-img" style="height:220px;">
                        @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                        {
                            <img src="@p.ImagePath" alt="@p.Name" />
                        }
                        else
                        {
                            <i class="bi bi-phone"></i>
                        }
                    </div>
                </a>
                @if (p.Stock > 0)
                {
                    <span class="badge bg-success position-absolute top-0 end-0 m-2">Còn @p.Stock</span>
                }
                else
                {
                    <span class="badge bg-secondary position-absolute top-0 end-0 m-2">Hết hàng</span>
                }

                @if (isAuth)
                {
                    <button class="btn btn-sm btn-light rounded-circle position-absolute top-0 start-0 m-2 wishlist-btn"
                            data-product-id="@p.Id" style="width:32px;height:32px;z-index:5;"
                            title="@(isLiked ? "Bỏ yêu thích" : "Thêm yêu thích")">
                        <i class="bi @(isLiked ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                    </button>
                }
            </div>

            <div class="card-body d-flex flex-column p-3">
                <a asp-action="Product" asp-route-id="@p.Id" class="fw-bold text-dark text-decoration-none mb-1" style="font-size:15px;line-height:1.3;">
                    @p.Name
                </a>
                <div class="small sf-muted mb-2">@p.Sku</div>

                @if (reviewCount > 0)
                {
                    <div class="product-rating mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(avg))
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else if (i - 0.5 <= avg)
                            {
                                <i class="bi bi-star-half"></i>
                            }
                            else
                            {
                                <i class="bi bi-star" style="color:#ddd;"></i>
                            }
                        }
                        <span>(@reviewCount)</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.Brand))
                {
                    <div class="small text-muted mb-1">@p.Brand</div>
                }

                <div class="product-price mb-3">@string.Format("{0:N0}", p.Price) đ</div>

                @if (ViewBag.ActivePromotions is List<Promotion> promos)
                {
                    var productPromos = promos.Where(pm => pm.PromotionProducts != null && pm.PromotionProducts.Any(pp => pp.ProductId == p.Id)).ToList();
                    foreach (var pm in productPromos.Take(1))
                    {
                        <div class="mt-1">
                            @if (pm.DiscountType == "Percentage")
                            {
                                <span class="product-promo-badge">-@pm.DiscountValue%</span>
                            }
                            else
                            {
                                <span class="product-promo-badge">-@pm.DiscountValue.ToString("N0")₫</span>
                            }
                            <span class="product-promo-code">@pm.Code</span>
                        </div>
                    }
                }

                <div class="mt-auto d-flex flex-column gap-2">
                    <form method="post" asp-controller="Cart" asp-action="Add" class="w-100">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <input type="hidden" name="qty" value="1" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button class="btn btn-danger w-100 sf-pill @(p.Stock<=0 ? "disabled" : "")" type="submit">
                            <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                        </button>
                    </form>

                    <form method="post" asp-controller="Cart" asp-action="BuyNow" class="w-100">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <input type="hidden" name="qty" value="1" />
                        <button class="btn btn-warning w-100 sf-pill @(p.Stock<=0 ? "disabled" : "")" type="submit">
                            <i class="bi bi-lightning-charge me-1"></i>Mua ngay
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
</div>

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-q="@q" asp-route-categoryId="@selectedCategory"
                       asp-route-sort="@sort" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice"
                       asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@if (recentArticles.Count > 0)
{
    <div class="mt-5 pt-3 border-top">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="fw-bold mb-0"><i class="bi bi-newspaper me-2 text-danger"></i>Bài viết mới nhất</h4>
            <a asp-area="Customer" asp-controller="News" asp-action="Index" class="btn btn-outline-danger btn-sm sf-pill">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-3">
            @foreach (var a in recentArticles)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm news-card">
                        <a asp-area="Customer" asp-controller="News" asp-action="Detail" asp-route-id="@a.Id" asp-route-slug="@a.Slug">
                            @if (!string.IsNullOrWhiteSpace(a.ImagePath))
                            {
                                <img src="@a.ImagePath" alt="@a.Title" class="card-img-top" style="height:160px;" />
                            }
                            else
                            {
                                <div class="card-img-top news-thumb-placeholder" style="height:160px;">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </a>
                        <div class="card-body p-3">
                            <a asp-area="Customer" asp-controller="News" asp-action="Detail" asp-route-id="@a.Id" asp-route-slug="@a.Slug"
                               class="fw-bold text-dark text-decoration-none" style="font-size:14px;line-height:1.3;">
                                @a.Title
                            </a>
                            <div class="small text-muted mt-2">
                                <i class="bi bi-calendar3 me-1"></i>@a.CreatedAt.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
<script>
    var bannerCarousel = document.getElementById('bannerCarousel');
    if (bannerCarousel) {
        new bootstrap.Carousel(bannerCarousel, { interval: 4000, ride: 'carousel', pause: false });
    }

    document.querySelectorAll('.wishlist-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const productId = this.dataset.productId;
            const icon = this.querySelector('i');
            fetch('@Url.Action("Toggle", "Wishlist")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'productId=' + productId
            }).then(r => r.json()).then(data => {
                if (data.liked) {
                    icon.className = 'bi bi-heart-fill text-danger';
                    this.title = 'Bỏ yêu thích';
                } else {
                    icon.className = 'bi bi-heart';
                    this.title = 'Thêm yêu thích';
                }
            });
        });
    });
</script>
}
