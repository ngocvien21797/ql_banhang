@model QuanLyBanHang.Models.SalesInvoice
@using QuanLyBanHang.Models
@{
    ViewData["Title"] = "Chi tiết đơn " + Model.Code;
    var subtotal = Model.Items.Sum(i => i.LineTotal);
    var sc = Model.Status switch { "Completed" => "success", "Cancelled" => "danger", "Shipped" => "primary", "Confirmed" => "info", _ => "secondary" };
    var pc = Model.PaymentStatus == "Paid" ? "success" : "warning";
    var showReview = TempData["ShowReview"] as string == "1";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="MyOrders" class="btn btn-outline-dark btn-sm rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
        <div>
            <h4 class="mb-0 fw-bold">Đơn hàng @Model.Code</h4>
            <small class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-@sc fs-6 px-3 py-2 rounded-pill">@SalesInvoice.DisplayStatus(Model.Status)</span>
        <span class="badge bg-@pc fs-6 px-3 py-2 rounded-pill">@SalesInvoice.DisplayPaymentMethod(Model.PaymentMethod) — @SalesInvoice.DisplayPaymentStatus(Model.PaymentStatus)</span>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success py-2 small border-0 rounded-3 shadow-sm">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2 small border-0 rounded-3 shadow-sm">@err</div>
}

<div class="row g-4">
    <!-- Cột trái: thông tin + timeline -->
    <div class="col-lg-5">
        <!-- Timeline -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-4"><i class="bi bi-clock-history text-danger me-2"></i>Trạng thái đơn hàng</h6>
                @{
                    var steps = Model.Status == "Cancelled"
                        ? new[] {
                            ("Tạo đơn", Model.CreatedAt, true, "bi-cart-check"),
                            ("Đã hủy", Model.CreatedAt.AddMinutes(30), true, "bi-x-circle")
                        }
                        : new[] {
                            ("Chờ xác nhận", Model.CreatedAt, true, "bi-cart-check"),
                            ("Đã xác nhận", Model.CreatedAt.AddMinutes(30), Model.Status != "Pending", "bi-check-lg"),
                            ("Đang giao", Model.CreatedAt.AddHours(2), Model.Status is "Shipped" or "Completed", "bi-truck"),
                            ("Hoàn thành", Model.CreatedAt.AddDays(1), Model.Status == "Completed", "bi-check2-all")
                        };
                }
                <div class="position-relative">
                    @foreach (var (label, time, done, icon) in steps)
                    {
                        <div class="d-flex @(done ? "opacity-100" : "opacity-50") mb-3 position-relative">
                            <div class="d-flex flex-column align-items-center me-3" style="width:32px;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center @(done ? "bg-success text-white" : "bg-light text-secondary")" style="width:32px;height:32px;font-size:14px;z-index:1;">
                                    <i class="bi @icon"></i>
                                </div>
                                @if (steps[^1].Item1 != label)
                                {
                                    <div class="flex-grow-1" style="width:2px;background:@(done ? "#198754" : "#dee2e6");min-height:24px;"></div>
                                }
                            </div>
                            <div class="pb-3">
                                <div class="fw-semibold @(done ? "text-dark" : "text-muted")">@label</div>
                                <div class="small text-muted">@time.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Thông tin nhận hàng -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-truck text-danger me-2"></i>Thông tin nhận hàng</h6>
                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width:32px;height:32px;">
                            <i class="bi bi-person text-muted"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">@Model.ReceiverName</div>
                            <div class="text-muted">@Model.ShippingPhone</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-2">
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width:32px;height:32px;">
                            <i class="bi bi-geo-alt text-muted"></i>
                        </div>
                        <div class="text-muted">@Model.ShippingAddress</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="d-flex align-items-start gap-2">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width:32px;height:32px;">
                                <i class="bi bi-chat text-muted"></i>
                            </div>
                            <div class="text-muted fst-italic">"@Model.Note"</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Hành động -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-lightning text-danger me-2"></i>Thao tác</h6>
                <div class="d-flex flex-column gap-2">
                    @if ((Model.PaymentMethod == "BANK" || Model.PaymentMethod == "WALLET") && Model.PaymentStatus != "Paid")
                    {
                        <a class="btn btn-danger w-100 rounded-pill" asp-controller="Payment" asp-action="Pay" asp-route-id="@Model.Id">
                            <i class="bi bi-credit-card me-1"></i>Thanh toán ngay
                        </a>
                    }
                    @if (Model.Status == "Pending")
                    {
                        <form asp-action="CancelOrder" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-outline-secondary w-100 rounded-pill" onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">
                                <i class="bi bi-x-circle me-1"></i>Hủy đơn hàng
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Shipped")
                    {
                        <form asp-action="ConfirmReceived" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-success w-100 rounded-pill py-2 fw-bold" onclick="return confirm('Xác nhận bạn đã nhận được hàng?')">
                                <i class="bi bi-check-lg me-1"></i>Đã nhận được hàng
                            </button>
                        </form>
                    }
                    @if (Model.Status is "Completed" or "Cancelled")
                    {
                        <form asp-action="Reorder" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-outline-danger w-100 rounded-pill">
                                <i class="bi bi-arrow-repeat me-1"></i>Mua lại
                            </button>
                        </form>
                    }
                    @if (Model.PaymentStatus == "Paid" && Model.PaidAt.HasValue)
                    {
                        <div class="text-center small text-success mt-2">
                            <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán @Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: sản phẩm + thanh toán -->
    <div class="col-lg-7">
        <!-- Danh sách sản phẩm -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-0">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0"><i class="bi bi-box text-danger me-2"></i>Sản phẩm đã mua</h6>
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2">@Model.Items.Count món</span>
                </div>

                @foreach (var i in Model.Items)
                {
                    <div class="p-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded flex-shrink-0 d-flex align-items-center justify-content-center overflow-hidden" style="width:60px;height:60px;">
                                @if (!string.IsNullOrWhiteSpace(i.Product?.ImagePath))
                                {
                                    <img src="@i.Product.ImagePath" alt="" style="width:60px;height:60px;object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-box text-muted fs-4"></i>
                                }
                            </div>
                            <div class="flex-grow-1 minw-0">
                                <a asp-action="Product" asp-route-id="@i.ProductId" class="fw-semibold text-dark text-decoration-none">@(i.Product?.Name ?? $"#{i.ProductId}")</a>
                                <div class="text-muted small">
                                    <span>Số lượng: @i.Quantity</span>
                                    <span class="mx-1">·</span>
                                    <span>@string.Format("{0:N0}", i.UnitPrice) đ / sản phẩm</span>
                                </div>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <div class="fw-bold text-danger fs-5">@string.Format("{0:N0}", i.LineTotal) đ</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Chi tiết thanh toán -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-credit-card text-danger me-2"></i>Chi tiết thanh toán</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Phương thức thanh toán</span>
                        <span class="fw-semibold">@SalesInvoice.DisplayPaymentMethod(Model.PaymentMethod)</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Trạng thái thanh toán</span>
                        <span class="badge bg-@pc rounded-pill">@SalesInvoice.DisplayPaymentStatus(Model.PaymentStatus)</span>
                    </div>
                    <hr class="my-1" />
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Tạm tính</span>
                        <span>@string.Format("{0:N0}", subtotal) đ</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Phí vận chuyển</span>
                        <span>@string.Format("{0:N0}", Model.ShippingFee) đ</span>
                    </div>
                    @if (Model.Discount > 0)
                    {
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Giảm giá</span>
                            <span class="text-success">-@string.Format("{0:N0}", Model.Discount) đ</span>
                        </div>
                    }
                    <hr class="my-1" />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Tổng cộng</span>
                        <span class="text-danger">@string.Format("{0:N0}", Model.Total) đ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .minw-0 { min-width: 0; }
    .star-rating { display: inline-flex; flex-direction: row-reverse; gap: 2px; }
    .star-rating input { display: none; }
    .star-rating label { cursor: pointer; font-size: 28px; color: #d1d5db; transition: color .15s; }
    .star-rating label:hover,
    .star-rating label:hover ~ label,
    .star-rating input:checked ~ label { color: #f59e0b; }
    .card.border-0.shadow-sm { border: 1px solid #c0c0c0 !important; box-shadow: none !important; }
</style>

<!-- Modal đánh giá sản phẩm -->
@if (Model.Status == "Completed" && Model.Items.Any())
{
    <div class="modal fade" id="reviewModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold"><i class="bi bi-star-fill text-warning me-2"></i>Đánh giá sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <p class="text-muted small mb-4">Cảm ơn bạn đã mua hàng! Hãy cho chúng tôi biết cảm nhận của bạn về từng sản phẩm.</p>
                    @foreach (var item in Model.Items)
                    {
                        <div class="border rounded-3 p-3 mb-3" data-product-id="@item.ProductId">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <div class="bg-light rounded flex-shrink-0 overflow-hidden" style="width:48px;height:48px;">
                                    @if (!string.IsNullOrWhiteSpace(item.Product?.ImagePath))
                                    {
                                        <img src="@item.Product.ImagePath" alt="" style="width:48px;height:48px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-box text-muted fs-4 d-flex align-items-center justify-content-center h-100"></i>
                                    }
                                </div>
                                <div class="flex-grow-1 minw-0">
                                    <div class="fw-semibold small">@(item.Product?.Name ?? $"#{item.ProductId}")</div>
                                </div>
                            </div>

                            <!-- Star rating -->
                            <div class="star-rating mb-2" data-product-id="@item.ProductId">
                                <input type="radio" name="rating_@item.ProductId" id="star5_@item.ProductId" value="5" />
                                <label for="star5_@item.ProductId" title="5 sao"><i class="bi bi-star-fill"></i></label>
                                <input type="radio" name="rating_@item.ProductId" id="star4_@item.ProductId" value="4" />
                                <label for="star4_@item.ProductId" title="4 sao"><i class="bi bi-star-fill"></i></label>
                                <input type="radio" name="rating_@item.ProductId" id="star3_@item.ProductId" value="3" checked />
                                <label for="star3_@item.ProductId" title="3 sao"><i class="bi bi-star-fill"></i></label>
                                <input type="radio" name="rating_@item.ProductId" id="star2_@item.ProductId" value="2" />
                                <label for="star2_@item.ProductId" title="2 sao"><i class="bi bi-star-fill"></i></label>
                                <input type="radio" name="rating_@item.ProductId" id="star1_@item.ProductId" value="1" />
                                <label for="star1_@item.ProductId" title="1 sao"><i class="bi bi-star-fill"></i></label>
                            </div>

                            <textarea class="form-control form-control-sm" rows="2" placeholder="Chia sẻ trải nghiệm của bạn..." style="border-radius:8px;"></textarea>
                            <div class="mt-2">
                                <input type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm" style="border-radius:8px;max-width:260px;" />
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Để sau</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" id="submitReviews">
                        <i class="bi bi-send me-1"></i>Gửi đánh giá
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    @if (showReview)
    {
        @:document.addEventListener('DOMContentLoaded', function () {
        @:    var modal = new bootstrap.Modal(document.getElementById('reviewModal'));
        @:    modal.show();
        @:});
    }

    document.getElementById('submitReviews')?.addEventListener('click', async function () {
        var btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...';

        var items = document.querySelectorAll('[data-product-id]');
        var errors = [];

        for (var el of items) {
            var productId = el.dataset.productId;
            var rating = el.querySelector('.star-rating input:checked');
            var content = el.querySelector('textarea');
            var fileInput = el.querySelector('input[type="file"]');
            var val = rating ? parseInt(rating.value) : 3;
            var txt = content ? content.value.trim() : '';

            var formData = new FormData();
            formData.append('productId', productId);
            formData.append('rating', val);
            formData.append('content', txt);
            if (fileInput && fileInput.files[0]) {
                formData.append('imageFile', fileInput.files[0]);
            }

            try {
                await fetch('@Url.Action("AddReview")', { method: 'POST', body: formData });
            } catch (e) {
                errors.push(productId);
            }
        }

        var modal = bootstrap.Modal.getInstance(document.getElementById('reviewModal'));
        modal.hide();

        var toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:9999;padding:12px 24px;border-radius:12px;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,.15);';
        if (errors.length === 0) {
            toast.className = 'alert alert-success border-0';
            toast.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Cảm ơn bạn đã đánh giá sản phẩm!';
        } else {
            toast.className = 'alert alert-danger border-0';
            toast.innerHTML = '<i class="bi bi-exclamation-circle me-2"></i>Có lỗi xảy ra, vui lòng thử lại.';
        }
        document.body.appendChild(toast);
        setTimeout(function () { toast.remove(); }, 4000);

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send me-1"></i>Gửi đánh giá';
    });
</script>
}
