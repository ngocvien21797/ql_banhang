@model QuanLyBanHang.Models.SalesInvoice
@{
    ViewData["Title"] = "Chi tiết đơn " + Model.Code;
    var subtotal = Model.Items.Sum(i => i.LineTotal);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Đơn hàng @Model.Code</h4>
        <small class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
    </div>
    <a class="btn btn-outline-dark btn-sm rounded-pill px-3" asp-action="MyOrders">← Quay lại</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success py-2 small">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2 small">@err</div>
}

<div class="row g-3">
    <!-- Tổng quan -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted d-block">Tổng thanh toán</small>
                    <span class="fw-bold text-danger fs-3">@string.Format("{0:N0}", Model.Total) đ</span>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    @{
                        var sc = Model.Status switch { "Completed" => "success", "Cancelled" => "danger", "Shipped" => "primary", "Confirmed" => "info", _ => "secondary" };
                        var pc = Model.PaymentStatus == "Paid" ? "success" : "warning";
                    }
                    <span class="badge bg-@sc">@SalesInvoice.DisplayStatus(Model.Status)</span>
                    <span class="badge bg-@pc">@SalesInvoice.DisplayPaymentMethod(Model.PaymentMethod) - @SalesInvoice.DisplayPaymentStatus(Model.PaymentStatus)</span>
                </div>
                @if ((Model.PaymentMethod == "BANK" || Model.PaymentMethod == "WALLET") && Model.PaymentStatus != "Paid")
                {
                    <a class="btn btn-danger w-100 mt-3 btn-sm rounded-pill" asp-controller="Payment" asp-action="Pay" asp-route-id="@Model.Id">Thanh toán</a>
                }
                @if (Model.PaymentStatus == "Paid" && Model.PaidAt.HasValue)
                {
                    <div class="small text-muted mt-2">Đã thanh toán @Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
            </div>
        </div>

        <!-- Thông tin nhận hàng -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-truck me-2"></i>Nhận hàng</h6>
                <div class="small lh-lg">
                    <div><i class="bi bi-person me-2 text-muted"></i>@Model.ReceiverName</div>
                    <div><i class="bi bi-telephone me-2 text-muted"></i>@Model.ShippingPhone</div>
                    <div><i class="bi bi-geo-alt me-2 text-muted"></i>@Model.ShippingAddress</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="mt-2 pt-2 border-top"><i class="bi bi-chat me-2 text-muted"></i>@Model.Note</div>
                    }
                </div>
            </div>
        </div>

        <!-- Timeline -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>Trạng thái</h6>
                <ul class="list-unstyled mb-0 small">
                    @{
                        var steps = Model.Status == "Cancelled"
                            ? new[] { ("Tạo đơn", Model.CreatedAt, true), ("Đã hủy", Model.CreatedAt.AddMinutes(30), true) }
                            : new[] { ("Chờ xác nhận", Model.CreatedAt, true), ("Đã xác nhận", Model.CreatedAt.AddMinutes(30), Model.Status != "Pending"), ("Đang giao", Model.CreatedAt.AddHours(2), Model.Status is "Shipped" or "Completed"), ("Hoàn thành", Model.CreatedAt.AddDays(1), Model.Status == "Completed") };
                    }
                    @foreach (var (label, time, done) in steps)
                    {
                        <li class="d-flex align-items-center gap-2 mb-2 @(!done ? "opacity-50" : "")">
                            <i class="bi @(done ? "bi-check-circle-fill text-success" : "bi-circle text-secondary")"></i>
                            <span>@label</span>
                            <span class="text-muted ms-auto">@time.ToString("dd/MM HH:mm")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Sản phẩm -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0"><i class="bi bi-box me-2"></i>Sản phẩm</h6>
                    <span class="badge bg-light text-dark">@Model.Items.Count món</span>
                </div>

                @foreach (var i in Model.Items)
                {
                    <div class="p-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded flex-shrink-0 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                                @if (!string.IsNullOrWhiteSpace(i.Product?.ImagePath))
                                {
                                    <img src="@i.Product.ImagePath" alt="" style="width:52px;height:52px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <i class="bi bi-box text-muted fs-4"></i>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <a asp-action="Product" asp-route-id="@i.ProductId" class="fw-semibold text-dark text-decoration-none">@(i.Product?.Name ?? $"#{i.ProductId}")</a>
                                <div class="text-muted small">SKU: @(i.Product?.Sku ?? "-")</div>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <div class="fw-bold text-danger">@string.Format("{0:N0}", i.LineTotal) đ</div>
                                <div class="text-muted small">@string.Format("{0:N0}", i.UnitPrice) đ x @i.Quantity</div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Tổng cộng -->
                <div class="p-3 bg-light">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Tạm tính</span>
                        <span>@string.Format("{0:N0}", subtotal) đ</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Vận chuyển</span>
                        <span>@string.Format("{0:N0}", Model.ShippingFee) đ</span>
                    </div>
                    @if (Model.Discount > 0)
                    {
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Giảm giá</span>
                            <span class="text-success">-@string.Format("{0:N0}", Model.Discount) đ</span>
                        </div>
                    }
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Tổng cộng</span>
                        <span class="text-danger">@string.Format("{0:N0}", Model.Total) đ</span>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Status is "Completed" or "Cancelled")
        {
            <div class="mt-2">
                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="reorder(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(i => i.ProductId).ToList())))">
                    <i class="bi bi-arrow-repeat me-1"></i>Mua lại
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function reorder(ids) {
    Promise.all(ids.map(pid =>
        fetch('@Url.Action("Add", "Cart")', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: 'productId=' + pid + '&qty=1'
        })
    )).then(() => window.location.href = '@Url.Action("Index", "Cart")');
}
</script>
}
