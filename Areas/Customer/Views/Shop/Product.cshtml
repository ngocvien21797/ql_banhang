@model QuanLyBanHang.Models.Product
@using QuanLyBanHang.Models
@using System.Text.Json
@{
    ViewData["Title"] = Model.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    string? imgSrc = null;
    if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        var p = Model.ImagePath.Trim();
        if (p.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            p.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            p.StartsWith("/"))
            imgSrc = p;
        else
            imgSrc = "/" + p;
    }

    var relatedProducts = ViewBag.RelatedProducts as List<Product> ?? new();
    var reviews = ViewBag.Reviews as List<Review> ?? new();
    var avgRating = (double)(ViewBag.AvgRating ?? 0);
    var reviewCount = (int)(ViewBag.ReviewCount ?? 0);
    var isWishlisted = (bool)(ViewBag.IsWishlisted ?? false);
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isCustomer = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "2";

    List<Dictionary<string, string>> specs = new();
    if (!string.IsNullOrWhiteSpace(Model.Specifications))
    {
        try { specs = JsonSerializer.Deserialize<List<Dictionary<string, string>>>(Model.Specifications) ?? new(); }
        catch { }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/product-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/promotions.css" asp-append-version="true" />
}

<div class="pd-wrap">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="pd-image-wrap">
                @if (!string.IsNullOrWhiteSpace(imgSrc))
                {
                    <img class="pd-image-main" src="@imgSrc" alt="@Model.Name" />
                }
                else
                {
                    <div class="pd-image-placeholder"><i class="bi bi-phone"></i></div>
                }
                @if (Model.Stock <= 0)
                {
                    <span class="badge bg-secondary position-absolute top-0 end-0 m-3 fs-6">Hết hàng</span>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="pd-info">
                <div class="pd-sku">SKU: @Model.Sku</div>
                <h1 class="pd-name">@Model.Name</h1>

                <div class="pd-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.Brand))
                    {
                        <span class="pd-meta-item"><i class="bi bi-building me-1"></i>@Model.Brand</span>
                        <span class="pd-meta-divider"></span>
                    }
                    @if (Model.Category != null)
                    {
                        <a class="pd-meta-item text-danger text-decoration-none" asp-action="Index" asp-route-categoryId="@Model.CategoryId">
                            <i class="bi bi-tag me-1"></i>@Model.Category.Name
                        </a>
                        <span class="pd-meta-divider"></span>
                    }
                    @if (Model.WarrantyMonths > 0)
                    {
                        <span class="pd-meta-item"><i class="bi bi-shield-check me-1 text-success"></i>Bảo hành @Model.WarrantyMonths tháng</span>
                        <span class="pd-meta-divider"></span>
                    }
                    @if (reviewCount > 0)
                    {
                        <span class="pd-meta-item">
                            <i class="bi bi-star-fill text-warning me-1"></i>@avgRating.ToString("0.0") (@reviewCount)
                        </span>
                    }
                </div>

                <div class="pd-price-wrap">
                    <div class="pd-price-label">Giá bán</div>
                    <div class="pd-price">@string.Format("{0:N0}", Model.Price) đ</div>
                </div>

                @if (ViewBag.ActivePromotions is List<Promotion> promos)
                {
                    var productPromos = promos.Where(p => p.PromotionProducts != null && p.PromotionProducts.Any(pp => pp.ProductId == Model.Id)).ToList();
                    if (productPromos.Any())
                    {
                        <div class="pd-promo-box">
                            <div class="pd-promo-title"><i class="bi bi-tag-fill me-1"></i>Khuyến mãi áp dụng</div>
                            @foreach (var pm in productPromos)
                            {
                                <div class="pd-promo-item">
                                    @if (pm.DiscountType == "Percentage")
                                    {
                                        <span class="pd-promo-badge">-@pm.DiscountValue%</span>
                                    }
                                    else
                                    {
                                        <span class="pd-promo-badge">-@pm.DiscountValue.ToString("N0")₫</span>
                                    }
                                    <span class="fw-semibold">@pm.Code</span>
                                    @if (pm.MinOrderValue.HasValue)
                                    {
                                        <small class="text-muted">(Đơn từ @pm.MinOrderValue.Value:N0₫)</small>
                                    }
                                </div>
                                if (!string.IsNullOrEmpty(pm.Description))
                                {
                                    <small class="text-muted d-block mt-1">@pm.Description</small>
                                }
                            }
                        </div>
                    }
                }

                <div class="pd-qty-wrap">
                    <label>Số lượng</label>
                    <input id="qty" class="pd-qty-input" type="number" min="1" value="1" />
                </div>

                <div class="pd-actions">
                    <a class="btn btn-outline-secondary sf-pill" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>

                    <form method="post" asp-controller="Cart" asp-action="Add" class="d-inline">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="qty" id="qtyAdd" value="1" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="btn btn-danger sf-pill @(Model.Stock<=0 ? "disabled" : "")" type="submit">
                            <i class="bi bi-cart-plus me-1"></i>Thêm giỏ
                        </button>
                    </form>

                    <form method="post" asp-controller="Cart" asp-action="BuyNow" class="d-inline">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="qty" id="qtyBuy" value="1" />
                        <button class="btn btn-warning sf-pill @(Model.Stock<=0 ? "disabled" : "")" type="submit">
                            <i class="bi bi-lightning-charge me-1"></i>Mua ngay
                        </button>
                    </form>

                    @if (isAuth)
                    {
                        <button class="btn btn-light sf-pill wishlist-btn-detail"
                                data-product-id="@Model.Id"
                                title="@(isWishlisted ? "Bỏ yêu thích" : "Thêm yêu thích")">
                            <i class="bi @(isWishlisted ? "bi-heart-fill text-danger" : "bi-heart") me-1"></i>
                            @(isWishlisted ? "Đã thích" : "Yêu thích")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Giới thiệu sản phẩm -->
    <div class="card border-0 shadow-sm mt-4" style="border-radius:12px;overflow:hidden;">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="bi bi-info-circle text-danger me-2"></i>Giới thiệu sản phẩm</h4>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="pd-intro">@Html.Raw(Model.Description.Replace("\n", "<br />"))</div>
            }
            else
            {
                <p class="text-muted">Chưa có thông tin giới thiệu cho sản phẩm này.</p>
            }
        </div>
    </div>

    <!-- Thông số kỹ thuật + Đánh giá -->
    <div class="row g-4 mt-2">
        @if (specs.Count > 0)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-gear text-danger me-2"></i>Thông số kỹ thuật</h5>
                        <table class="pd-specs-table">
                            <tbody>
                                @foreach (var spec in specs)
                                {
                                    <tr>
                                        <td>@spec.GetValueOrDefault("label", "")</td>
                                        <td>@spec.GetValueOrDefault("value", "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="@(specs.Count > 0 ? "col-lg-6" : "col-12")">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-star text-danger me-2"></i>Đánh giá
                        @if (reviewCount > 0)
                        {
                            <span class="text-muted fw-normal small">(@reviewCount)</span>
                        }
                    </h5>

                    @if (reviews.Count == 0)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-chat-square-text" style="font-size:48px;color:#ddd;"></i>
                            <p class="mt-2 text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
                        </div>
                    }
                    else
                    {
                        <div class="pd-review-summary">
                            <div class="pd-review-score">
                                <div class="pd-review-score-value">@avgRating.ToString("0.0")</div>
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(avgRating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star" style="color:#ddd;"></i>
                                        }
                                    }
                                </div>
                                <div class="pd-review-score-label">@reviewCount đánh giá</div>
                            </div>
                        </div>

                        @foreach (var r in reviews)
                        {
                            <div class="pd-review-item">
                                <div class="pd-review-author">@(r.Customer?.Name ?? "Ẩn danh")</div>
                                <div class="pd-review-date">@r.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="text-warning mb-2" style="font-size:13px;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= r.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star" style="color:#ddd;"></i>
                                        }
                                    }
                                </div>
                                <div class="pd-review-content">@(!string.IsNullOrWhiteSpace(r.Content) ? r.Content : "Không có nhận xét")</div>
                                @if (!string.IsNullOrWhiteSpace(r.ImagePath))
                                {
                                    <img class="pd-review-image" src="@r.ImagePath" alt="Ảnh đánh giá" />
                                }
                            </div>
                        }
                    }

                    @if (!isAuth)
                    {
                        <div class="mt-4 text-center p-4 bg-light rounded-3">
                            <p class="mb-2">Vui lòng <a asp-area="" asp-controller="Account" asp-action="Login" class="text-danger fw-bold">đăng nhập</a> để viết đánh giá.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Sản phẩm liên quan -->
    @if (relatedProducts.Count > 0)
    {
        <div class="mt-5">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-link-45deg text-danger fs-4"></i>
                <h4 class="fw-bold mb-0">Sản phẩm liên quan</h4>
            </div>
            <div class="row g-3">
                @foreach (var rp in relatedProducts)
                {
                    <div class="col-6 col-md-3">
                        <div class="card product-card h-100">
                            <a asp-action="Product" asp-route-id="@rp.Id">
                                <div class="sf-img" style="height:160px;">
                                    @if (!string.IsNullOrWhiteSpace(rp.ImagePath))
                                    {
                                        <img src="@rp.ImagePath" alt="@rp.Name" style="height:160px;object-fit:cover;width:100%;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-phone"></i>
                                    }
                                </div>
                            </a>
                            <div class="card-body p-3">
                                <a asp-action="Product" asp-route-id="@rp.Id" class="fw-bold text-dark text-decoration-none" style="font-size:14px;">@rp.Name</a>
                                <div class="product-price mt-2" style="font-size:16px;">@string.Format("{0:N0}", rp.Price) đ</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    const qty = document.getElementById('qty');
    const qtyAdd = document.getElementById('qtyAdd');
    const qtyBuy = document.getElementById('qtyBuy');
    if (qty) {
        qty.addEventListener('input', () => {
            var v = Math.max(1, parseInt(qty.value || '1', 10));
            qty.value = v;
            if (qtyAdd) qtyAdd.value = v;
            if (qtyBuy) qtyBuy.value = v;
        });
    }

    const wishlistBtn = document.querySelector('.wishlist-btn-detail');
    if (wishlistBtn) {
        wishlistBtn.addEventListener('click', function(e) {
            e.preventDefault();
            var productId = this.dataset.productId;
            var icon = this.querySelector('i');
            fetch('@Url.Action("Toggle", "Wishlist")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'productId=' + productId
            }).then(function(r) { return r.json();             }).then(function(data) {
                if (data.liked) {
                    icon.className = 'bi bi-heart-fill text-danger me-1';
                    this.title = 'B\u1ecf y\u00eau th\u00edch';
                    this.innerHTML = '<i class="bi bi-heart-fill text-danger me-1"></i> \u0110\u00e3 th\u00edch';
                } else {
                    icon.className = 'bi bi-heart me-1';
                    this.title = 'Th\u00eam y\u00eau th\u00edch';
                    this.innerHTML = '<i class="bi bi-heart me-1"></i> Y\u00eau th\u00edch';
                }
            }.bind(this));
        });
    }
</script>
}
