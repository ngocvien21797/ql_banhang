@model QuanLyBanHang.ViewModels.CheckoutVM
@{
    ViewData["Title"] = "Thanh toán";
    var hasError = ViewBag.ValidationErrors == true || TempData["Error"] != null;
    var promos = ViewBag.ApplicablePromotions as List<QuanLyBanHang.Models.Promotion>;
}
@section Styles{
    <link rel="stylesheet" href="~/css/customer/Checkout.css" />
}

<div class="checkout-page">
    <div class="container">

        <!-- HEADER -->
        <div class="checkout-header">
            <h2><i class="bi bi-credit-card me-2"></i>Thanh toán đơn hàng</h2>
            <p>Kiểm tra thông tin và hoàn tất đặt hàng</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="checkout-alert alert alert-danger d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i> @TempData["Error"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="checkout-alert alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Vui lòng kiểm tra lại thông tin:
                <ul class="mb-0 mt-1">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div id="checkoutErrors" class="checkout-alert alert alert-danger" style="display:none;"></div>

        <form method="post" asp-action="PlaceOrder" id="checkoutForm" class="checkout-form">
            <div class="row g-4">

                <!-- ========== LEFT COLUMN ========== -->
                <div class="col-lg-7">

                    <!-- RECEIVER INFO -->
                    <div class="checkout-card mb-3">
                        <div class="section-title">
                            <i class="bi bi-person-fill"></i>
                            Thông tin người nhận
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Chọn địa chỉ nhận hàng</label>
                            <div class="saved-addresses" id="savedAddresses">
                                @if (Model.SavedAddresses.Count > 0)
                                {
                                    @foreach (var a in Model.SavedAddresses)
                                    {
                                        <div class="saved-addr-option @(a.Id == Model.SelectedAddressId ? "selected" : "")"
                                             onclick="selectAddress(@a.Id, this)">
                                            <input type="radio" name="SelectedAddressId" value="@a.Id"
                                                   @(a.Id == Model.SelectedAddressId ? "checked" : "") hidden />
                                            <div class="saved-addr-info">
                                                <div class="saved-addr-name">
                                                    @a.ReceiverName
                                                    @if (a.IsDefault)
                                                    {
                                                        <span class="badge bg-danger ms-1" style="font-size:10px;">Mặc định</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(a.Label))
                                                    {
                                                        <span class="badge bg-light text-dark ms-1" style="font-size:10px;">@a.Label</span>
                                                    }
                                                </div>
                                                <div class="saved-addr-detail">@a.Phone &middot; @a.Address</div>
                                            </div>
                                            <i class="bi bi-check-circle-fill saved-addr-check"></i>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small py-2">Chưa có địa chỉ nào.</div>
                                }
                            </div>
                        </div>

                        <!-- Hidden fields for selected address data -->
                        <input type="hidden" name="ReceiverName" id="hidReceiverName" value="@Model.ReceiverName" />
                        <input type="hidden" name="Phone" id="hidPhone" value="@Model.Phone" />
                        <input type="hidden" name="Address" id="hidAddress" value="@Model.Address" />

                        <div class="d-flex align-items-center gap-2 mt-2">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="showAddAddressModal()">
                                <i class="bi bi-plus-circle me-1"></i>Thêm địa chỉ mới
                            </button>
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input class="checkout-input" name="Email" id="checkoutEmail" value="@Model.Email"
                                   placeholder="email@example.com" type="email" required style="max-width:350px;" />
                            <span class="field-error" data-field="Email"></span>
                        </div>
                    </div>

                    <!-- SHIPPING METHOD -->
                    <div class="checkout-card mb-3">
                        <div class="section-title">
                            <i class="bi bi-truck"></i>
                            Phương thức vận chuyển
                        </div>
                        <div class="shipping-list">
                            <label class="shipping-option @(Model.ShippingMethod == "standard" ? "selected" : "")">
                                <input type="radio" name="ShippingMethod" value="standard"
                                @(Model.ShippingMethod == "standard" ? "checked" : "") />
                                <span class="radio-custom"></span>
                                <div class="shipping-info">
                                    <div class="shipping-title">
                                        <i class="bi bi-box"></i> Giao hàng tiêu chuẩn
                                    </div>
                                    <div class="shipping-desc">Nhận hàng sau 3-5 ngày làm việc</div>
                                </div>
                                <div class="shipping-fee" data-method="standard">
                                    <span class="shipping-fee-label">20,000đ – 35,000đ</span>
                                </div>
                            </label>
                            <label class="shipping-option @(Model.ShippingMethod == "economy" ? "selected" : "")">
                                <input type="radio" name="ShippingMethod" value="economy"
                                @(Model.ShippingMethod == "economy" ? "checked" : "") />
                                <span class="radio-custom"></span>
                                <div class="shipping-info">
                                    <div class="shipping-title">
                                        <i class="bi bi-send"></i> Giao tiết kiệm
                                    </div>
                                    <div class="shipping-desc">Nhận hàng sau 5-7 ngày làm việc</div>
                                </div>
                                <div class="shipping-fee" data-method="economy">
                                    <span class="shipping-fee-label">15,000đ – 25,000đ</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- PAYMENT METHOD -->
                    <div class="checkout-card mb-3">
                        <div class="section-title">
                            <i class="bi bi-credit-card-2-front"></i>
                            Phương thức thanh toán
                        </div>
                        <div class="payment-list">
                            <label class="payment-option @(Model.PaymentMethod == "COD" ? "selected" : "")">
                                <input type="radio" name="PaymentMethod" value="COD"
                                @(Model.PaymentMethod == "COD" ? "checked" : "") />
                                <span class="radio-custom"></span>
                                <div class="payment-info">
                                    <div class="payment-title">
                                        <i class="bi bi-cash-stack"></i> COD — Thanh toán khi nhận hàng
                                    </div>
                                    <div class="payment-desc">Thanh toán trực tiếp khi shipper giao hàng đến bạn.</div>
                                </div>
                            </label>
                            <label class="payment-option @(Model.PaymentMethod == "BANK" ? "selected" : "")">
                                <input type="radio" name="PaymentMethod" value="BANK"
                                @(Model.PaymentMethod == "BANK" ? "checked" : "") />
                                <span class="radio-custom"></span>
                                <div class="payment-info">
                                    <div class="payment-title">
                                        <i class="bi bi-bank"></i> Chuyển khoản ngân hàng
                                    </div>
                                    <div class="payment-desc">Thanh toán qua QR code hoặc nhập thông tin tài khoản.</div>
                                </div>
                            </label>

                        </div>
                    </div>

                    <!-- NOTE -->
                    <div class="checkout-card mb-3">
                        <div class="section-title">
                            <i class="bi bi-chat-dots"></i>
                            Ghi chú đơn hàng
                        </div>
                        <textarea class="checkout-input" name="Note" rows="3"
                                  placeholder="Ghi chú cho người bán (không bắt buộc)">@Model.Note</textarea>
                    </div>

                </div>

                <!-- ========== RIGHT COLUMN ========== -->
                <div class="col-lg-5">

                    <div class="checkout-summary">

                        <h4><i class="bi bi-receipt me-2"></i>Đơn hàng</h4>

                        <!-- PRODUCTS -->
                        <div class="summary-products mb-3">
                            @foreach (var line in Model.Lines)
                            {
                                <div class="summary-item">
                                    <div class="summary-left">
                                        <div class="summary-thumb">
                                            @if (!string.IsNullOrEmpty(line.Product.ImagePath))
                                            {
                                                <img src="@line.Product.ImagePath" alt="@line.Product.Name" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-box"></i>
                                            }
                                        </div>
                                        <div class="summary-details">
                                            <div class="summary-name">@line.Product.Name</div>
                                            <div class="summary-meta">@string.Format("{0:N0}₫", line.Product.Price) × @line.Quantity</div>
                                        </div>
                                    </div>
                                    <div class="summary-price">@string.Format("{0:N0}₫", line.LineTotal)</div>
                                </div>
                            }
                        </div>

                        <!-- VOUCHER -->
                        <div class="voucher-row" style="position:relative;">
                            <input class="checkout-input" id="voucherInput" name="VoucherCode"
                                   value="@Model.VoucherCode" placeholder="Nhập mã giảm giá"
                                   autocomplete="off" />
                            <button type="button" id="applyVoucherBtn" class="voucher-btn">
                                <i class="bi bi-ticket-perforated"></i> Áp dụng
                            </button>
                            @if (promos != null && promos.Count > 0)
                            {
                                <div id="promoSuggestions" class="promo-suggestions">
                                    <div class="promo-suggest-title">Mã khuyến mãi áp dụng</div>
                                    @foreach (var p in promos)
                                    {
                                        <div class="promo-suggest-item" data-code="@p.Code"
                                             onclick="document.getElementById('voucherInput').value=this.dataset.code;applyVoucher();this.closest('.promo-suggestions').classList.remove('show');">
                                            <div class="promo-suggest-left">
                                                <i class="bi bi-ticket-perforated"></i>
                                            </div>
                                            <div class="promo-suggest-info">
                                                <div class="promo-suggest-name">@p.Name</div>
                                                <div class="promo-suggest-code">Mã: <strong>@p.Code</strong></div>
                                                <div class="promo-suggest-desc">@p.Description</div>
                                            </div>
                                            <div class="promo-suggest-badge">
                                                @if (p.DiscountType == "Percentage")
                                                {
                                                    <span>-@(((int)p.DiscountValue).ToString())%</span>
                                                }
                                                else
                                                {
                                                    <span>-@string.Format("{0:N0}₫", p.DiscountValue)</span>
                                                }
                                                @if (p.MinOrderValue.HasValue)
                                                {
                                                    <span class="promo-suggest-min">Đơn từ @string.Format("{0:N0}₫", p.MinOrderValue)</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div id="voucherResult" class="voucher-result"></div>

                        <hr class="checkout-divider" />

                        <!-- TOTALS -->
                        <div class="summary-row">
                            <span>Tạm tính</span>
                            <strong id="displaySubtotal">@string.Format("{0:N0}₫", Model.Subtotal)</strong>
                            <input type="hidden" id="hidSubtotal" value="@Model.Subtotal" />
                        </div>
                        <div class="summary-row">
                            <span>Phí vận chuyển</span>
                            <strong id="displayShipping">@string.Format("{0:N0}₫", Model.ShippingFee)</strong>
                            <input type="hidden" id="hidShipping" value="@Model.ShippingFee" />
                        </div>
                        <div class="summary-row" id="discountRow" style="@(Model.Discount > 0 ? "" : "display:none")">
                            <span><i class="bi bi-ticket-perforated me-1"></i>Giảm giá</span>
                            <strong class="text-success" id="displayDiscount">-@string.Format("{0:N0}₫", Model.Discount)</strong>
                            <input type="hidden" id="hidDiscount" value="@Model.Discount" />
                            <input type="hidden" id="hidPromoCode" value="@Model.VoucherCode" />
                        </div>
                        <div class="summary-total">
                            <span>Tổng cộng</span>
                            <strong id="displayTotal">@string.Format("{0:N0}₫", Model.Total)</strong>
                            <input type="hidden" id="hidTotal" value="@Model.Total" />
                        </div>

                        <!-- SUBMIT -->
                        <button type="button" class="checkout-submit-btn" id="placeOrderBtn"
                                onclick="showConfirmOrder()">
                            <i class="bi bi-check2-circle"></i> Đặt hàng
                        </button>

                        <button type="button" class="checkout-back-btn"
                                onclick="location.href='@Url.Action("Index","Cart")'">
                            <i class="bi bi-arrow-left"></i> Quay lại giỏ hàng
                        </button>

                    </div>

                </div>

            </div>
        </form>

<!-- Confirm Order Modal -->
<div class="modal fade" id="confirmOrderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i>Xác nhận đặt hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Bạn có chắc chắn muốn đặt đơn hàng này?</p>
                <div class="bg-light p-3 rounded-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Người nhận:</span>
                        <span class="fw-semibold" id="confirmName">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">SĐT:</span>
                        <span class="fw-semibold" id="confirmPhone">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Địa chỉ:</span>
                        <span class="fw-semibold text-end" style="max-width:60%;" id="confirmAddress">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Email:</span>
                        <span class="fw-semibold" id="confirmEmail">-</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Tạm tính:</span>
                        <span id="confirmSubtotal">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Phí ship:</span>
                        <span id="confirmShipping">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1" id="confirmDiscountRow" style="display:none;">
                        <span class="text-muted">Giảm giá:</span>
                        <span class="text-danger" id="confirmDiscount">-</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Tổng cộng:</span>
                        <span class="text-danger" id="confirmTotal">-</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-danger" onclick="submitOrder()">
                    <i class="bi bi-check-lg me-1"></i>Xác nhận đặt hàng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Thêm địa chỉ mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                    <input class="form-control" id="modalReceiverName" placeholder="Nhập họ tên" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                    <input class="form-control" id="modalPhone" placeholder="090xxxxxxx" type="tel" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                    <input class="form-control" id="modalAddress" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Ghi chú (VD: Nhà riêng, Cơ quan)</label>
                    <input class="form-control" id="modalLabel" placeholder="Nhà riêng" />
                </div>
                <div id="modalError" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-danger" onclick="saveNewAddress()">
                    <i class="bi bi-check-lg me-1"></i>Lưu địa chỉ
                </button>
            </div>
        </div>
    </div>
</div>

    </div>
</div>

@section Scripts{
    <script>
        // ==================== SAVED ADDRESSES ====================
        function selectAddress(id, el) {
            document.querySelectorAll('.saved-addr-option').forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
            el.querySelector('input[type="radio"]').checked = true;

            fetch('@Url.Action("GetAddress","Checkout")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ id })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('hidReceiverName').value = data.receiverName;
                    document.getElementById('hidPhone').value = data.phone;
                    document.getElementById('hidAddress').value = data.address;
                }
            });
        }

        function showAddAddressModal() {
            document.getElementById('modalReceiverName').value = '';
            document.getElementById('modalPhone').value = '';
            document.getElementById('modalAddress').value = '';
            document.getElementById('modalLabel').value = '';
            document.getElementById('modalError').classList.add('d-none');
            var modal = new bootstrap.Modal(document.getElementById('addAddressModal'));
            modal.show();
        }

        function saveNewAddress() {
            var name = document.getElementById('modalReceiverName').value.trim();
            var phone = document.getElementById('modalPhone').value.trim();
            var addr = document.getElementById('modalAddress').value.trim();
            var label = document.getElementById('modalLabel').value.trim();

            var errDiv = document.getElementById('modalError');
            errDiv.classList.add('d-none');

            if (!name) { showModalError('Vui lòng nhập họ tên.'); return; }
            if (!phone) { showModalError('Vui lòng nhập số điện thoại.'); return; }
            if (!addr) { showModalError('Vui lòng nhập địa chỉ.'); return; }

            fetch('@Url.Action("AddAddress","Checkout")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ receiverName: name, phone: phone, address: addr, label: label })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    var newCard = document.createElement('div');
                    newCard.className = 'saved-addr-option selected';
                    newCard.setAttribute('onclick', 'selectAddress(' + data.id + ', this)');
                    newCard.innerHTML =
                        '<input type="radio" name="SelectedAddressId" value="' + data.id + '" checked hidden>' +
                        '<div class="saved-addr-info">' +
                            '<div class="saved-addr-name">' + data.receiverName + '</div>' +
                            '<div class="saved-addr-detail">' + data.phone + ' &middot; ' + data.address + '</div>' +
                        '</div>' +
                        '<i class="bi bi-check-circle-fill saved-addr-check"></i>';

                    var container = document.getElementById('savedAddresses');
                    var emptyMsg = container.querySelector('.text-muted.small');
                    if (emptyMsg) emptyMsg.remove();
                    document.querySelectorAll('.saved-addr-option').forEach(o => o.classList.remove('selected'));
                    container.prepend(newCard);

                    document.getElementById('hidReceiverName').value = data.receiverName;
                    document.getElementById('hidPhone').value = data.phone;
                    document.getElementById('hidAddress').value = data.address;

                    bootstrap.Modal.getInstance(document.getElementById('addAddressModal')).hide();
                } else {
                    showModalError(data.message || 'Không thể lưu địa chỉ.');
                }
            })
            .catch(function () {
                showModalError('Lỗi kết nối, vui lòng thử lại.');
            });
        }

        function showModalError(msg) {
            var errDiv = document.getElementById('modalError');
            errDiv.textContent = msg;
            errDiv.classList.remove('d-none');
        }

        // ==================== REAL-TIME VALIDATION ====================
        // Email validation
        const emailInput = document.querySelector('input[name="Email"]');
        if (emailInput) {
            emailInput.addEventListener('blur', function () {
                const errSpan = document.querySelector('.field-error[data-field="Email"]');
                if (!errSpan) return;
                const v = this.value.trim();
                if (v && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v)) {
                    this.classList.add('is-invalid');
                    errSpan.textContent = 'Email không hợp lệ';
                    errSpan.style.display = 'block';
                } else {
                    this.classList.remove('is-invalid');
                    errSpan.textContent = '';
                    errSpan.style.display = 'none';
                }
            });
        }

        // ==================== PAYMENT OPTION SELECT ====================
        document.querySelectorAll('.payment-option').forEach(opt => {
            opt.addEventListener('click', function () {
                document.querySelectorAll('.payment-option').forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                this.querySelector('input[type="radio"]').checked = true;
            });
        });

        // ==================== SHIPPING OPTION SELECT ====================
        document.querySelectorAll('.shipping-option').forEach(opt => {
            opt.addEventListener('click', function () {
                document.querySelectorAll('.shipping-option').forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                this.querySelector('input[type="radio"]').checked = true;
                updateShipping();
            });
        });

        // ==================== UPDATE SHIPPING FEE ====================
        async function updateShipping() {
            const method = document.querySelector('input[name="ShippingMethod"]:checked')?.value || 'standard';
            try {
                const res = await fetch('@Url.Action("CalcShippingFee","Checkout")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ method, province: '' })
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('displayShipping').textContent = data.fee.toLocaleString() + '₫';
                    document.getElementById('hidShipping').value = data.fee;
                    recalcTotal();
                }
            } catch (e) { console.log('calc shipping error', e); }
        }

        // ==================== VOUCHER ====================
        document.getElementById('applyVoucherBtn')?.addEventListener('click', applyVoucher);
        document.getElementById('voucherInput')?.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); applyVoucher(); }
        });

        async function applyVoucher() {
            const code = document.getElementById('voucherInput')?.value || '';
            const subtotal = parseFloat(document.getElementById('hidSubtotal')?.value || '0');
            const resultDiv = document.getElementById('voucherResult');

            if (!code.trim()) {
                resultDiv.innerHTML = '<span class="text-muted small">Vui lòng nhập mã giảm giá.</span>';
                return;
            }

            resultDiv.innerHTML = '<span class="text-muted small"><i class="bi bi-hourglass-split me-1"></i>Đang kiểm tra...</span>';

            try {
                const res = await fetch('@Url.Action("CheckVoucher","Checkout")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ code, subtotal })
                });
                const data = await res.json();

                if (data.success) {
                    resultDiv.innerHTML =
                        `<span class="voucher-success"><i class="bi bi-check-circle-fill me-1"></i>${data.discountLabel}: -${data.discount.toLocaleString()}₫</span>`;
                    document.getElementById('displayDiscount').innerHTML = '-<strong>' + data.discount.toLocaleString() + '₫</strong> <span class="text-muted small">' + data.promoCode + '</span>';
                    document.getElementById('hidDiscount').value = data.discount;
                    document.getElementById('hidPromoCode').value = data.promoCode;
                    document.getElementById('discountRow').style.display = 'flex';
                } else {
                    resultDiv.innerHTML =
                        `<span class="voucher-error"><i class="bi bi-x-circle-fill me-1"></i>${data.message}</span>`;
                    document.getElementById('displayDiscount').innerHTML = '-<strong>0₫</strong>';
                    document.getElementById('hidDiscount').value = 0;
                    document.getElementById('hidPromoCode').value = '';
                    document.getElementById('discountRow').style.display = 'none';
                }
                recalcTotal();
            } catch (e) {
                resultDiv.innerHTML = '<span class="voucher-error"><i class="bi bi-exclamation-circle me-1"></i>Lỗi kết nối, vui lòng thử lại.</span>';
            }
        }

        // ==================== AUTO-FILL VOUCHER FROM CART ====================
        document.addEventListener('DOMContentLoaded', function() {
            const saved = sessionStorage.getItem('voucherCode');
            if (saved && !document.getElementById('voucherInput').value) {
                document.getElementById('voucherInput').value = saved;
                setTimeout(applyVoucher, 500);
            }
        });

        // Clear session storage after successful voucher application
        const origApplyVoucher = applyVoucher;
        applyVoucher = async function() {
            await origApplyVoucher.apply(this, arguments);
            const resultDiv = document.getElementById('voucherResult');
            if (resultDiv && resultDiv.querySelector('.voucher-success')) {
                sessionStorage.removeItem('voucherCode');
            }
        };

        // ==================== PROMO SUGGESTIONS DROPDOWN ====================
        var voucherInput = document.getElementById('voucherInput');
        var suggestions = document.getElementById('promoSuggestions');
        if (voucherInput && suggestions) {
            voucherInput.addEventListener('focus', function () {
                suggestions.classList.add('show');
            });
            voucherInput.addEventListener('blur', function () {
                setTimeout(function () { suggestions.classList.remove('show'); }, 200);
            });
        }

        // ==================== RECALC TOTAL ====================
        function recalcTotal() {
            const subtotal = parseFloat(document.getElementById('hidSubtotal').value) || 0;
            const shipping = parseFloat(document.getElementById('hidShipping').value) || 0;
            const discount = parseFloat(document.getElementById('hidDiscount').value) || 0;
            const total = subtotal + shipping - discount;
            document.getElementById('displayTotal').textContent = total.toLocaleString() + '₫';
            document.getElementById('hidTotal').value = total;

        }

        // ==================== CONFIRM ORDER ====================
        function showConfirmOrder() {
            var name = document.getElementById('hidReceiverName').value.trim();
            var phone = document.getElementById('hidPhone').value.trim();
            var addr = document.getElementById('hidAddress').value.trim();
            var email = document.getElementById('checkoutEmail').value.trim();
            var errors = [];

            if (!name) errors.push('Thiếu họ tên người nhận.');
            if (!phone) errors.push('Thiếu số điện thoại.');
            else if (!/^0[0-9]{9,10}$/.test(phone)) errors.push('Số điện thoại không hợp lệ (10-11 số, bắt đầu bằng 0).');
            if (!addr) errors.push('Thiếu địa chỉ giao hàng.');
            if (!email) errors.push('Thiếu email nhận xác nhận.');
            else if (email.indexOf('@@') < 0 || email.indexOf('.') < 0) errors.push('Email không hợp lệ.');

            if (errors.length > 0) {
                var msg = '<i class="bi bi-exclamation-circle me-1"></i> Vui lòng kiểm tra lại thông tin:<ul class="mb-0 mt-1">';
                for (var i = 0; i < errors.length; i++) {
                    msg += '<li>' + errors[i] + '</li>';
                }
                msg += '</ul>';
                var errDiv = document.getElementById('checkoutErrors');
                errDiv.innerHTML = msg;
                errDiv.style.display = 'block';
                errDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            document.getElementById('confirmName').textContent = name;
            document.getElementById('confirmPhone').textContent = phone;
            document.getElementById('confirmAddress').textContent = addr;
            document.getElementById('confirmEmail').textContent = email;

            document.getElementById('confirmSubtotal').textContent = document.getElementById('displaySubtotal')?.textContent || '-';
            document.getElementById('confirmShipping').textContent = document.getElementById('displayShipping')?.textContent || '-';

            var discountRow = document.getElementById('discountRow');
            if (discountRow && discountRow.style.display !== 'none') {
                document.getElementById('confirmDiscountRow').style.display = 'block';
                document.getElementById('confirmDiscount').textContent = document.getElementById('displayDiscount')?.textContent || '-';
            } else {
                document.getElementById('confirmDiscountRow').style.display = 'none';
            }

            document.getElementById('confirmTotal').textContent = document.getElementById('displayTotal')?.textContent || '-';

            var modal = new bootstrap.Modal(document.getElementById('confirmOrderModal'));
            modal.show();
        }

        function submitOrder() {
            var btn = document.getElementById('placeOrderBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang xử lý...';
            bootstrap.Modal.getInstance(document.getElementById('confirmOrderModal')).hide();
            document.getElementById('checkoutForm').submit();
        }
    </script>
}
