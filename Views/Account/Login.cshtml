@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-header">
            <div class="auth-logo"><i class="bi bi-bag-check-fill"></i></div>
            <h2>Đăng nhập</h2>
            <p>Chào mừng bạn quay trở lại</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-group">
                <label class="form-label">Tên đăng nhập</label>
                <input class="form-control" name="username" required placeholder="Nhập tên đăng nhập" />
            </div>

            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                <input type="password" class="form-control" name="password" required minlength="6" placeholder="Nhập mật khẩu" />
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>
                <a href="#" class="small text-danger text-decoration-none">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="auth-btn"><i class="bi bi-box-arrow-in-right"></i>Đăng nhập</button>

            <div class="auth-footer">
                Chưa có tài khoản? <a asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl">Đăng ký ngay</a>
            </div>

            <a asp-area="Customer" asp-controller="Shop" asp-action="Index" class="back-shop-btn">
                <i class="bi bi-arrow-left"></i>Quay lại cửa hàng
            </a>
        </form>
    </div>
</div>
